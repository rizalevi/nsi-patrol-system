@{
	Layout = "_Layout";

}

<div class="panel panel-inverse" style="min-height:86vh;">
	<div class="panel-heading theme-color">
		<h4 class="panel-title fs-5"><i class="bi bi-sign-stop"></i> [@ViewBag.Permission.MenuId] - @ViewBag.Permission.MenuName</h4>
		<div class="panel-heading-btn">
			<a href="javascript:;" class="btn btn-xs btn-icon btn-default panel-border-white" data-toggle="panel-expand"><i class="fa fa-expand"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-success panel-border-white" data-toggle="panel-reload"><i class="fa fa-redo"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-warning panel-border-white" data-toggle="panel-collapse"><i class="fa fa-minus"></i></a>
		</div>
	</div>
	<div class="panel-body">
		<div class="row">
			<div class="panel-heading col-md-10">
				<div class="row">
					<div class="row mb-2">
						<div class="col-lg-5 col-md-12">
							<!--ClusterCode-->
							<div class="filter-item">
							<label>Cluster</label>
							<select id="ClusterCode" name="ClusterCode" class="form-select">
							</select>
							<input id="ClusterName" class="form-control input-desc" type="text" readonly placeholder="Cluster Name" />
							</div>
						</div>

						<div class="col-lg-5 col-md-12">
							<!--GroupCode-->
							<div class="filter-item">
								<label>Group</label>
								<select id="GroupCode" name="GroupCode" class="form-select" >
									<option value="">Fill a Group</option>
								</select>
								<input id="GroupName" class="form-control input-desc" type="text" readonly placeholder="Group Name" />
							</div>
						</div>

					</div>
					<div class="row mb-2">
						<div class="col-lg-5 col-md-12">
							<!--plant-->
							<div class="filter-item">
								<label>Plant</label>
								<select id="PlantCode" name="PlantCode" class="form-select">
									<option value="">Fill a Plant</option>
								</select>
								<input id="PlantName" class="form-control input-desc" type="text" readonly placeholder="Plant Name" />

							</div>
						</div>
						<div class="col-lg-5 col-md-12">

							<!--inspection date -->
							<div class="filter-item">
								<label>Inspection Date</label>
								<div class="datepicker-wrapper">
									<input id="InspectionDateFrom" name="InspectionDateFrom" type="text" class="form-control datepicker" autocomplete="off" style="height:2.1rem" />
									<span class="datepicker-icon">
										<i class="fa fa-calendar"></i>
									</span>
								</div>
							</div>
						</div>
					</div>
					<div class="row mb-2">
						<div class="col-lg-5 col-md-12">
							<!-- CourseCode -->
							<div class="filter-item">
								<label>Course</label>
								<select id="CourseCode" name="CourseCode" class="form-select">
								</select>
								<input id="CourseName" class="form-control input-desc" type="text" readonly placeholder="Course Name" />
							</div>
						</div>
						<div class="col-lg-5 col-md-12">
							<!-- Frequency -->
							<div class="filter-item">
								<label>Frequency</label>
								<select id="Frequency" name="Frequency" class="form-select">
									<option value="">Fill a Frequency</option>
								</select>

							</div>
						</div>
					</div>

				</div>

			</div>
		</div>

		<div class="btn-common-panel">
			<div style="display:flex; gap:10px;">
				<form id="formBack" method="post" action="/TasklistRemaining/index" style="display:inline;">

					<button type="submit" class="btn btn-danger btn-sm fs-13px btn-back hidden">
						<i class="fa fa-arrow-left"></i>&nbsp;  Back
					</button>
				</form>
				<button class="btn btn-primary btn-sm fs-11px btn-search"><i class="fa fa-search"></i> Browse</button>
				<button class="btn btn-secondary btn-sm btn-clear"><i class="fa fa-refresh"></i> Clear</button>
				@if (ViewBag.Permission.AllowUpdate == "0")
				{
					<button class="btn btn-primary btn-sm fs-11px btn-submit" disabled><i class="fa fa-check"></i> Approve</button>
				}
				else
				{
					<button class="btn btn-primary btn-sm fs-11px btn-submit"><i class="fa fa-check"></i> Approve</button>

				}
			</div>
			<!-- RIGHT: SEARCH -->
			<div class="smart-search">
				<i class="fa fa-search"></i>
				<input type="text" class="dt-search" data-table="#tableID" placeholder="Search..." />
			</div>
		</div>

		<!-- PANEL BODY -->
		<div class="table-responsive">
			<table id="tableID" class="table table-striped table-bordered w-100 fs-13px" >
				<thead>
					<tr role="row">

						@* <th rowspan="2" style="text-align:center;">
							Inspection Date
						</th> *@
						<th rowspan="2" style="text-align:center;min-width:120px;">
							Frequency
						</th>
						<th rowspan="2" style="text-align:center;min-width:150px;">
							Course
						</th>
						<th rowspan="2" style="text-align:center;min-width:150px;">
							Equipment Group
						</th>
						<th colspan="3" style="text-align:center;">
							Inspector
						</th>
						<th colspan="3" style="text-align:center;">
							Leader
						</th>


					</tr>
					<tr>
						<th style="text-align:center;">
							Check
						</th>
						<th style="text-align:center;">
							Name
						</th>
						<th style="text-align:center;">
							Date
						</th>
						<th style="text-align:center;">
							Check
						</th>
						<th style="text-align:center;">
							Name
						</th>
						<th style="text-align:center;">
							Date
						</th>

					</tr>

				</thead>
			</table>
		</div>


		<div class="modal fade" id="MyModal" data-bs-backdrop="static" data-bs-keyboard="false">
			<div class="modal-dialog modal-dialog-centered" style="--bs-modal-width:1000px !important;height:85vh !important;">
				<div class="modal-content">

					<div class="modal-header  theme-color">
						<h5 class="modal-title" id="ModalTitle">Inspetion Check Detail</h5>
						<button type="button" class="btn-close bg-white-200" data-bs-dismiss="modal"></button>
					</div>

					<div class="modal-body">
						<div class="panel-body">
						<div style="border:1px solid lightgray; padding:5px; margin-top:5px" class="row">
							<div class="row mb-2">
								<div class="col-lg-5 col-md-12">
									<div class="filter-item">
										<label>Course</label>
										<input id="Course" class="form-control" type="text" maxlength="18" readonly />

									</div>
								</div>
								<div class="col-lg-5 col-md-12">
									<div class="filter-item">
										<label>Title</label>
										<input id="Title" class="form-control" type="text" maxlength="35" readonly />
									</div>
								</div>
							</div>

							<div class="row mb-2">
								<div class="col-lg-5 col-md-12">
									<div class="filter-item">
										<label> Group</label>
										<input id="Group" name="Group" class="form-control" type="text" maxlength="18" readonly />
									</div>
								</div>
								<div class="col-lg-5 col-md-12">
									<div class="filter-item">
										<label>Inspection Date</label>
										<input id="InspectionDate" class="form-control" type="text" maxlength="15" readonly />
										<span></span>
										<input id="FrequencyName" class="form-control" type="text" maxlength="15" readonly />
									</div>
								</div>
							</div>
							<div style="display:none;">
								<input id="GroupCodeModal" readonly />
								<input id="InspectionNo" readonly />
							</div>
						</div>

						<div class="btn-common-panel">
							<div style="display:flex; gap:10px;">
								@if (ViewBag.Permission.AllowUpdate == "0")
								{
									<button type="button" class="btn btn-danger btn-popupsendback" disabled><i class="fa fa-refresh"></i> Send Back</button>
									<button type="button" class="btn btn-primary btn-check-approve" disabled><i class="fa fa-check"></i> Check</button>
								}
								else
								{
									<button type="button" class="btn btn-danger btn-popupsendback"><i class="fa fa-refresh"></i> Send Back</button>
									<button type="button" class="btn btn-primary btn-check-approve"><i class="fa fa-check"></i> Check</button>
								}
							</div>
							<!-- RIGHT: SEARCH -->
							<div class="smart-search">
								<i class="fa fa-search"></i>
								<input type="text" class="dt-search" data-table="#tableID-Detail" placeholder="Search..." />
							</div>
						</div>


						<div class="table-responsive">
							<table id="tableID-Detail" class="table table-striped table-bordered w-100 fs-13px">
								<thead>
									<tr role="row">
										<th rowspan="2" style="text-align:center;width:50px">
										</th>
										<th rowspan="2" style="text-align:center;width:150px">
											Group
										</th>
										<th rowspan="2" style="text-align:center;width:200px">
											Inspection Point
										</th>
										<th rowspan="2" style="text-align:center;width:130px">
											Unit
										</th>
										<th colspan="2" style="text-align:center;width:140px">
											Range
										</th>
										<th rowspan="2" style="text-align:center;width:150px">
											Inspection Result
										</th>
										<th rowspan="2" style="text-align:center;width:120px">
											Status
										</th>

									</tr>
									<tr>
										<th style="text-align:center;width:70px">
											Min
										</th>
										<th style="text-align:center;width:70px">
											Max
										</th>
									</tr>
								</thead>
							</table>
						</div>


						<div class="col-md-12" style="margin-top:50px;border-top:1px solid gainsboro;">
							<div style="padding-top:3px;">
								<label> Remarks inspector : </label>
							</div>
						</div>
						<div class="col-md-12">
							<textarea class="form-control" id="Remarks" rows="2" disabled style="resize: none;" autocomplete="false">
							</textarea>
						</div>

							<div class="col-md-12" style="border-top:1px solid gainsboro;">
								<div style="padding-top:1px;">
									<label> Remarks leader : </label>
								</div>
							</div>
							<div class="col-md-12">
								<textarea class="form-control" id="RemarksLeader" rows="2"  style="resize: none;" autocomplete="false">
							</textarea>
							</div>
					</div>


				</div>
			</div>

			</div>
		</div>


		<div class="modal fade sendback" id="modalSendBack" data-bs-backdrop="static" data-bs-keyboard="false">
			<div class="modal-dialog modal-sm modal-center" >
				<div class="modal-content" style="width:500px !important;">
				
					<div class="modal-header  theme-color">
						<h5 class="modal-title" id="ModalTitle2">Send Back to Inspector</h5>
						<button type="button" class="btn-close bg-white-200" data-bs-dismiss="modal"></button>
					</div>


					<div class="modal-body" style="width:500px;">
						<div class="col-md-9">
							<textarea class="form-control" id="RemarksSendBack" rows="3" style="resize:block;text-align:left;width:450px" autocomplete="false"
										placeholder="Send back">
									</textarea>
						</div>
					</div>
					<div class="modal-footer">
						@if (ViewBag.Permission.AllowUpdate == "0")
						{
							<button type="button" class="btn btn-primary btn-submit-sendback" disabled><i class="fa fa-save"></i> Send Back</button>
						}
						else
						{
							<button type="button" class="btn btn-primary btn-submit-sendback"><i class="fa fa-save"></i> Send Back</button>
						}
					</div>
				</div>

			</div>
		</div>
	</div>
</div>


@section Styles {
	<link rel="stylesheet" href="~/assets/css/pages/InspectionDataCheck.css" asp-append-version="true" />


}

@section Scripts {
	<script>
		var clusterCode = '@ViewData["ClusterCode"]';
		var plantCode = '@ViewData["PlantCode"]';
		var courseCode = '@ViewData["CourseCode"]';
		var groupCode = '@ViewData["GroupCode"]';
		var inspectionDate = '@ViewData["InspectionDate"]';
		var frequency = '@ViewData["Frequency"]';
	</script>
	<script asp-append-version="true">
		window.userPermission = {
			statusAdmin: @(ViewBag.Permission?.StatusAdmin),
			allowUpdate: @(ViewBag.Permission?.AllowUpdate),
			allowDelete: @(ViewBag.Permission?.AllowDelete),
			allowApprove: @(ViewBag.Permission?.AllowApprove)
		};
	</script>

	<script src="~/assets/js/pages/InspectionDataCheck.js" asp-append-version="true"></script>

}
 