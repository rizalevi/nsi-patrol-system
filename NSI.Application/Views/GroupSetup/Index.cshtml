@{
	Layout = "_Layout";

}


<div class="panel panel-inverse" style="min-height:60vh;">
	<div class="panel-heading theme-color">
		<h4 class="panel-title fs-5"><i class="bi bi-sign-stop"></i> [@ViewBag.Permission.MenuId] - @ViewBag.Permission.MenuName</h4>
		<div class="panel-heading-btn">
			<a href="javascript:;" class="btn btn-xs btn-icon btn-default panel-border-white" data-toggle="panel-expand"><i class="fa fa-expand"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-success panel-border-white" data-toggle="panel-reload"><i class="fa fa-redo"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-warning panel-border-white" data-toggle="panel-collapse"><i class="fa fa-minus"></i></a>
		</div>
	</div>

	<div class="panel-body">
		<!-- BUTTON -->
		<div class="btn-common-panel">
			<div style="display:flex; gap:20px;">
				@if (ViewBag.Permission.AllowUpdate == "0")
				{
					<button class="btn btn-success btn-sm btn-add" disabled><i class="fa fa-plus"></i> New</button>
					<button class="btn btn-success btn-sm btn-save" disabled><i class="fa fa-save"></i> Save</button>

				}
				else
				{
					<button class="btn btn-success btn-sm btn-add"><i class="fa fa-plus"></i> New</button>
					<button class="btn  btn-success btn-sm btn-save"><i class="fa fa-save"></i> Save</button>

				}

				<button class="btn btn-secondary btn-sm btn-clear"><i class="fa fa-refresh" onclick="Clear()"></i> Clear</button>
				<button class="btn btn-danger btn-sm btn-delete"><i class="fa fa-trash-o"></i>  Delete </button>
			</div>
		</div>

		<div class="row main-grid">

			<!-- LEFT PANEL -->
			<div class="col-md-5 card">
				<div>
					<h6 style="color:black;margin:0;font-weight:bold;padding:5px;">Group List</h6>
					<hr style="margin-bottom:10px;margin-top:5px;" />
				</div>
				<div class="table-responsive">
					<table id="tableID" class="table table-striped table-bordered table-hover" width:"100%" style="font-family:'Trebuchet MS'">
						<thead>
							<tr role="row">
								<th style="text-align:center;width:10%">

								</th>
								<th style="text-align:center;width:30%">
									Group ID
								</th>
								<th style="text-align:center;width:60%">
									Group Name
								</th>
							</tr>
						</thead>
						<tbody>
						</tbody>
					</table>
				</div>

			</div>

			<!-- RIGHT PANEL -->
			<div class="col-md-7 card">
				<div>
					<h6 style="color:black;margin:0;font-weight:bold;padding:5px;">Group Information</h6>
					<hr style="margin-bottom:10px;margin-top:5px;" />
				</div>

				<div class="group-form-container">
					<form id="form">

						<!-- Group ID -->
						<div class="form-row-custom">
							<label class="form-label-custom">
								Group ID
							</label>

							<div class="form-input-custom">
								<input id="GroupID"
									   type="text"
									   class="form-control"
									   maxlength="15"
									   autocomplete="off">
							</div>
						</div>

						<!-- Group Name -->
						<div class="form-row-custom">
							<label class="form-label-custom">
								Group Name
							</label>

							<div class="form-input-custom">
								<input id="GroupName"
									   type="text"
									   class="form-control"
									   maxlength="50"
									   autocomplete="off">
							</div>
						</div>

						<!-- Cluster -->
						<div class="form-row-custom">

							<label class="form-label-custom">
								Cluster
							</label>

							<div class="form-input-custom">

								<div class="d-flex align-items-center flex-wrap gap-2">

									<div class="filter-ddl">
										<select id="ClusterCode"
												name="ClusterCode"
												class="form-select fs-13px">
											<option value="">
												Fill a Cluster
											</option>
										</select>
									</div>

									<input id="ClusterName"
										   name="ClusterName"
										   class="form-control input-desc fs-13px"
										   type="text"
										   readonly
										   placeholder="Cluster Name" />

								</div>

							</div>

						</div>

						<!-- Plant -->
						<div class="form-row-custom">

							<label class="form-label-custom">
								Plant
							</label>

							<div class="form-input-custom">

								<div class="d-flex align-items-center flex-wrap gap-2">

									<div class="filter-ddl">
										<select id="PlantCode"
												name="PlantCode"
												class="form-select fs-13px">
											<option value="">
												Fill a Plant
											</option>
										</select>
									</div>

									<input id="PlantName"
										   name="PlantName"
										   class="form-control input-desc fs-13px"
										   type="text"
										   readonly
										   placeholder="Plant Name" />

								</div>

							</div>

						</div>

						<!-- Checkbox -->
						<div class="form-row-custom">

							<label class="form-label-custom"></label>

							<div class="form-input-custom">

								<div class="checkbox-group">

									<label>
										<input type="checkbox"
											   id="Inspector"
											   checked>
										Inspector
									</label>

									<label>
										<input type="checkbox"
											   id="Leader"
											   checked>
										Leader
									</label>

									<label>
										<input type="checkbox"
											   id="Checker"
											   checked>
										Checker
									</label>

									<label>
										<input type="checkbox"
											   id="Supervisor"
											   checked>
										Supervisor
									</label>

								</div>

							</div>

						</div>

					</form>
				</div>

			</div>

		</div>

		<!-- TABLE -->
		<div class="card-tab">

			<!-- TAB HEADER -->
			<div class="tabs">
				<button class="tab active" data-tab="privilege">Group Privilege</button>
				<button class="tab" data-tab="course">Course Setting</button>
			</div>

			<!-- TAB CONTENT -->
			<div class="tab-content active" id="privilege">
				<div class="table-responsive">
					<div class="col-md-10">
						<table id="tableID2" class="table table-striped table-bordered table-hover" style="font-family:'Trebuchet MS';min-width:1100px">
							<thead>
								<tr role="row">
									<th style="vertical-align:central;text-align:center;width:100px;">No</th>
									<th style="vertical-align:central;text-align:center;width:150px;">Group Menu</th>
									<th style="vertical-align:central;text-align:center;width:150px;">Menu ID</th>
									<th style="vertical-align:central;text-align:center;width:400px;">Description</th>
									<th style="vertical-align:central;text-align:center;width:100px;">Display</th>
									<th style="vertical-align:central;text-align:center;width:100px;">Update</th>
									<th style="vertical-align:central;text-align:center;width:100px;">Delete</th>
								</tr>
							</thead>
							<tbody>
							</tbody>
						</table>
					</div>
				</div>

			</div>

			<div class="tab-content" id="course">

				<div class="table-responsive">
					<div class="col-md-7">
						<table id="tableID3" class="table table-striped table-bordered table-hover" width:"100%" style="font-family:'Trebuchet MS';min-width:780px;">
							<thead>
								<tr role="row">
									<th style="vertical-align:central;text-align:center;width:100px;">No</th>
									<th style="vertical-align:central;text-align:center;width:200px;">Course Code</th>
									<th style="vertical-align:central;text-align:center;width:400px">Title</th>
									<th style="vertical-align:central;text-align:center;width:100px;">Show</th>
								</tr>
							</thead>
							<tbody>
							</tbody>
						</table>
					</div>
				</div>

			</div>

		</div>

	</div>
</div>

<link href="~/assets/css/pages/groupsetup.css" rel="stylesheet" asp-append-version="true" />
@section Scripts {
	<script asp-append-version="true">
		window.userPermission = {
			statusAdmin: @(ViewBag.Permission?.StatusAdmin),
			allowUpdate: @(ViewBag.Permission?.AllowUpdate),
			allowDelete: @(ViewBag.Permission?.AllowDelete),
			allowApprove: @(ViewBag.Permission?.AllowApprove)
		};
	</script>
	<script src="~/assets/js/pages/groupsetup.js" asp-append-version="true"></script>
}