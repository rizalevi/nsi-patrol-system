    <script src="~/js/plugin/datatables/dataTables.fixedColumns.min.js" asp-append-version="true"></script>
    <script src="~/js/plugin/datatable-responsive/datatables.responsive.min.js" asp-append-version="true"></script>

    <!--chart js 2.8.1-->
