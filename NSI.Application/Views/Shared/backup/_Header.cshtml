<header id="header">
  
    <div id="logo-group">
        <span id="logo">
            <img src="~/content/img/LogoNSI.png" width="30px" height="30px" alt="NSI" />
            <span class="page-logo-text">NSI Patrol System</span>
        </span>
    </div>

    <!-- RIGHT HEADER -->
    <div class="pull-right">

      
        <!-- COLLAPSE MENU -->
        <div class="btn-header transparent pull-right">
            <span >
                <a href="javascript:void(0);"
                   data-action="toggleMenu"
                   title="Toggle Menu">
                    <i class="fa fa-bars"></i>
                </a>
            </span>
        </div>

        <!-- LOGOUT -->
        <div id="logout" class="btn-header transparent pull-right">
            <span>
                <a href="javascript:void(0);" title="Sign Out">
                    <i class="fa fa-sign-out"></i>
                </a>
            </span>
        </div>


        <div class="btn-header transparent pull-right"><span style="margin:5px"></span></div>

       
        <!-- NOTIFICATION -->
        <div class="btn-header transparent pull-right notif-wrapper">
            <span>
                <a href="javascript:void(0);" id="btnNotification">
                    <i class="fa fa-bell"></i>
                    <span class="notif-badge" id="notifCount">0</span>
                </a>
            </span>
        </div>

        <!-- USER NAME -->
        <div class="btn-header transparent pull-right">
            <span class="user-name">
                Welcome, @User.Identity.Name
            </span>
        </div>
    </div>



