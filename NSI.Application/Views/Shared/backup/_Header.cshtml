</header>
<style src="text/css">
    /* body.swal2-toast-shown .swal2-container.swal2-top-end, body.swal2-toast-shown .swal2-container.swal2-top-right {
        top: 50px !important;
        right: 20px !important;
        bottom: auto;
        left: auto;
    } */

    .swal-logout-popup {
        border-radius: 10px;
    }
    
    .swal-logout-popup .swal2-title {
        font-size: 20px;
    }

    

    @@keyframes pulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.2);
        }

        100% {
            transform: scale(1);
        }
    }

   
</style>
<script>
   

        document.getElementById("logout").addEventListener("click", function(e) {
            const btn = e.currentTarget;
            const rect = btn.getBoundingClientRect();

        Swal.fire({
            icon: 'warning',
            title: 'Logout',
            html: '<p>Apakah kamu yakin ingin keluar?</p>',
            showCancelButton: true,
            confirmButtonText: 'Yes',
            cancelButtonText: 'No',
            focusCancel: true,
            buttonsStyling: true,
            width: 350,
            height: 200,
            customClass: {
                popup: 'swal-logout-popup'
            },
            didOpen: (popup) => {
                popup.style.position = 'absolute';
                popup.style.top = (rect.bottom + window.scrollY + 20) + 'px';
                popup.style.left = (rect.right - popup.offsetWidth) + 'px';
            }
        }).then((result) => {
            if (result.isConfirmed) {
                // Redirect ke action logout
                window.location.href = '@Url.Action("Logout", "Account")';
            }
        });
    });
  

</script>


