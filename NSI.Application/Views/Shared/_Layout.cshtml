@using Microsoft.AspNetCore.Http

@{
    string appMode = "";

    if (Context.Request.Cookies.TryGetValue("app-theme-dark-mode", out string appModeValue))
    {
        if (appModeValue == "dark-mode")
        {
            appMode = "dark";
        }
    }
}
