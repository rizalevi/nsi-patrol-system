@{
	Layout = "_Layout";

}
<div class="panel panel-inverse" style="min-height:86vh;">
	<div class="panel-heading theme-color">
		<h4 class="panel-title fs-5"><i class="bi bi-sign-stop"></i> [@ViewBag.Permission.MenuId] - @ViewBag.Permission.MenuName</h4>
		<div class="panel-heading-btn">
			<a href="javascript:;" class="btn btn-xs btn-icon btn-default panel-border-white" data-toggle="panel-expand"><i class="fa fa-expand"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-success panel-border-white" data-toggle="panel-reload"><i class="fa fa-redo"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-warning panel-border-white" data-toggle="panel-collapse"><i class="fa fa-minus"></i></a>
		</div>
	</div>
	<div class="panel-body">
		<div class="panel-heading  col-md-12">
			<div class="row">
				<div class="row mb-2">
					<div class="col-lg-4 col-md-12">
						<!-- Cluster -->
						<div class="filter-item">
							<label>Cluster</label>
							<select id="ClusterCode" name="ClusterCode" class="form-select">
								<option value="">Fill a Cluster</option>
							</select>
							<input id="ClusterName" class="form-control input-desc" type="text" readonly />
						</div>
						
					</div>

					<div class="col-lg-4 col-md-12">
						
						<!-- Frequency -->
						<div class="filter-item">
							<label>Frequency</label>
							<select id="Frequency" name="Frequency" class="form-select">
								<option value="">Fill a Frequency</option>
							</select>
							<input id="FrequencyName" name="FrequencyName" class="form-control input-desc" type="text" readonly />
						</div>
						
					</div>

					<div class="col-lg-4 col-md-12">
						@* <div class="d-flex align-items-center"> *@
							<div class="filter-item">

								<label>Inspection Date</label>
								<div class="datepicker-wrapper">
									<input id="InspectionDateFrom" name="InspectionDateFrom" type="text" class="form-control datepicker" autocomplete="off" style="height:35px;" />
									<span class="datepicker-icon">
										<i class="fa fa-calendar"></i>
									</span>
								</div>
								<div class="datepicker-wrapper">
								<input id="InspectionDateTo" name="InspectionDateTo" type="text" class="form-control datepicker" autocomplete="off" style="height:35px;" />
									<span class="datepicker-icon">
										<i class="fa fa-calendar"></i>
									</span>
								</div>
							</div>
						
					</div>

				</div>

				<!-- Row 2 -->
				<div class="row mb-2">
					<div class="col-lg-4">
					<!-- Plant -->
						<div class="filter-item">
							<label>Plant</label>
							<select id="PlantCode" name="PlantCode" class="form-select">
								<option value="">Fill a Plant</option>
							</select>
							<input id="PlantName" class="form-control input-desc" type="text" readonly />
						</div>
					</div>
					<div class="col-lg-8">
						<!--group-->
						<div class="filter-item">
							<label>Group</label>
							<select id="GroupCode" name="GroupCode" class="form-select">
								<option value="">Fill a Group</option>
							</select>
							<input id="GroupName" class="form-control input-desc" type="text" readonly />
						</div>
					</div>



				</div>

				<!-- Row 3 -->
				<div class="row mb-2">
					<div class="col-lg-4 col-md-12">
						<div class="filter-item">
							<label>Course</label>
							<select id="CourseCode" name="CourseCode" class="form-select">
								<option value="">Fill a Course</option>
							</select>
							<input id="CourseName" class="form-control input-desc" type="text" readonly />

						</div>
					</div>
					<div class="col-lg-4 col-md-12">
						<!-- Inspection Point -->
						<div class="filter-item">
							<label>Inspection Point</label>
							<select id="InspectionPointCode" name="InspectionPointCode" class="form-select">
								<option value="">Fill a Inspection Point</option>
							</select>
							<input id="InspectionPointName" class="form-control input-desc" type="text" readonly />
							<!-- NAV PREV NEXT BUTTON -->
							@Html.Partial("~/Views/PartialView/_NavButtons.cshtml")
						</div>
						

					</div>
					
				</div>

			</div>

		</div>

		<div class="btn-common-panel">
			<div style="display:flex; gap:10px;">
				<button class="btn btn-primary btn-sm  btn-search"><i class="fa fa-search"></i> Browse</button>
				<button class="btn btn-secondary btn-sm btn-clear"><i class="fa fa-refresh"></i> Clear</button>
				<button class="btn btn-danger btn-sm btn-print"><i class="fa fa-print"></i> Print</button>
				<button class="btn btn-success btn-sm btn-excel"><i class="fa fa-excel"></i> Excel</button>
			</div>
			<!-- RIGHT: SEARCH -->
			<div class="smart-search">
				<i class="fa fa-search"></i>
				<input type="text" class="dt-search" data-table="#tableID" placeholder="Search..." />
			</div>

		</div>

		<!-- PANEL BODY -->
		<div class="table-responsive">
			<table id="tableID" class="table table-striped table-bordered w-100 fs-13px" style="min-width:2000px">
				<thead>
					<tr role="row">
						<th rowspan="2" style="text-align:center;width:80px">

						</th>
						<th rowspan="2" style="text-align:center;min-width:120px">
							Date
						</th>
						<th rowspan="2" style="text-align:center;width:150px;">
							Frequency
						</th>
						<th rowspan="2" style="text-align:center;width:120px">
							Plant
						</th>
						<th rowspan="2" style="text-align:center;width:180px">
							Course
						</th>
						<th rowspan="2" style="text-align:center;width:200px">
							Equipment Group
						</th>
						<th rowspan="2" style="text-align:center;width:200px">
							Inspection Point
						</th>
						<th rowspan="2" style="text-align:center;width:120px">
							Unit
						</th>
						<th colspan="2" style="text-align:center;max-width:150px">
							Range
						</th>

						<th rowspan="2" style="text-align:center;width:150px">
							Inspection Result
						</th>
						<th rowspan="2" style="text-align:center;width:120px">
							Status
						</th>
						<th rowspan="2" style="text-align:center;width:150px">
							Group
							Selection
						</th>
						<th rowspan="2" style="text-align:center;width:110px">
							Inspection
							User
						</th>
						<th rowspan="2" style="text-align:center;min-width:150px">
							Notes
						</th>
					</tr>
					<tr>
						<th style="text-align:center;max-width:75px;">
							Min
						</th>
						<th style="text-align:center;max-width:75px">
							Max
						</th>
					</tr>
				</thead>

				<tbody></tbody>

			</table>

		</div>
	</div>

	<div id="modalReport" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false">
		<div class="modal-dialog modal-dialog-centered" style="--bs-modal-width:1500px !important;height:85vh !important;">
			<div class="modal-content">

				<div class="modal-header theme-color">
					<h5 class="modal-title">Inspection Report</h5>
					<button type="button" class="btn-close bg-white-200" data-bs-dismiss="modal"></button>
				</div>

				<div class="modal-body p-0">
					<iframe id="reportFrame"
							style="width:100%;height:85vh;border:none;">
					</iframe>
				</div>

				<div class="modal-footer">
					@*  <button class="btn btn-primary" onclick="printReport()">🖨 Print</button> *@
					<button class="btn btn-secondary" data-bs-dismiss="modal" >Close</button>
				</div>

			</div>
		</div>
	</div>
</div>
<style>
	.filter-item {
		display: grid;
		grid-template-columns: 100px 180px 230px 200px;
		align-items: center;
		gap: 8px;
	}

		.filter-item label {
			width: 100px;
			min-width: 100px;
			margin-bottom: 0;
		}
	/*
		.filter-item select {
			width: 180px;
		}*/

	.input-desc {
		width: 100% !important;
	}

	.datepicker-wrapper {
		position: relative;
		width: 180px !important;
	}

		.datepicker-wrapper input {
			width: 100%;
		}

	.datepicker-icon {
		position: absolute;
		right: 10px;
		top: 50%;
		transform: translateY(-50%);
	}


	/* =======================================================
		   1920+
		======================================================= */
	@@media (min-width: 1900px) {
		.filter-item

	{
			grid-template-columns: 100px 180px 230px 200px;
		gap: 10px;
	}

	.filter-item select, .filter-item .select2-container .datepicker-wrapper {
		width: 180px !important;
	}

		.datepicker-wrapper {
			position: relative;
			width: 180px !important;
		}
	}
	/* =======================================================
		   1600 - 1899
		======================================================= */
	@@media (min-width: 1600px) and (max-width: 1899px) {
		.filter-item

	{
			grid-template-columns: 80px 180px 180px 200px;
		gap: 10px;
	}

	.filter-item select, .filter-item .select2-container .datepicker-wrapper {
		width: 180px !important;
	}

		.datepicker-wrapper {
			position: relative;
			width: 180px !important;
		}
	.input-desc {
		width: 100% !important;
	}

	}

	/* =======================================================
		   1360 - 1599
		======================================================= */
	@@media (min-width: 1360px) and (max-width: 1599px) {
		.filter-item

	{
			grid-template-columns: 100px 150px 150px 200px;
	}

	.filter-item select,
	.filter-item .select2-container
	.datepicker-wrapper {
		width: 150px !important;
	}

		.datepicker-wrapper {
			position: relative;
			width: 150px !important;
		}
	.input-desc {
		width: 100% !important;
	}

	.smart-search {
		width: 240px;
	}

	}

	/* =======================================================
		   1280 - 1359
		======================================================= */
	@@media (min-width: 1280px) and (max-width: 1359px) {
		.filter-item

	{
			grid-template-columns: 80px 150px 180px 200px;
	}

	.filter-item select,
	.filter-item .select2-container
	.datepicker-wrapper {
		width: 150px !important;
	}

		.datepicker-wrapper {
			position: relative;
			width: 150px !important;
		}
	.input-desc {
		width: 100% !important;
	}

	.smart-search {
		width: 220px;
	}

	.btn-common-panel .btn {
		font-size: 11px;
	}

	}

	/* =======================================================
		   1024 - 1279
		======================================================= */
	@@media (min-width: 1024px) and (max-width: 1279px) {
		.filter-item

	{
			grid-template-columns: 75px 140px 160px 200px;
	}

	.filter-row {
		gap: 10px;
	}

	.filter-item label {
		width: 75px;
	}

	.filter-item select,
	.filter-item .select2-container
	.datepicker-wrapper {
		width: 140px !important;
	}

		.datepicker-wrapper {
			position: relative;
			width: 140px !important;
		}
	.input-desc {
		width: 100% !important;
	}

	.smart-search {
		width: 180px;
	}

	.btn-common-panel .btn {
		font-size: 10px;
		padding-left: .5rem;
		padding-right: .5rem;
	}

	}

	/* =======================================================
		   800 - 1023
		======================================================= */
	@@media (max-width: 1023px) {
		.filter-row

	{
		flex-direction: column;
		gap: 8px;
	}

	.filter-item {
		width: 100%;
	}

		.filter-item label {
			width: 90px;
		}

		.filter-item select,
		.filter-item .select2-container
		.datepicker-wrapper {
			width: 180px !important;
		}

		.datepicker-wrapper {
			position: relative;
			width: 180px !important;
		}
	.input-desc {
		width: 100% !important;
	}

	.btn-common-panel {
		flex-direction: column;
		align-items: stretch;
	}

	.smart-search {
		width: 100%;
	}

	}

	/* =======================================================
			800
	======================================================= */
	@@media (min-width: 768px) and (max-width: 1023px) {
		.filter-item

	{
		grid-template-columns: 90px 140px !important 100%;
	}

	.filter-item label {
		width: 90px;
	}

	.filter-item select,
	.filter-item .select2-container
	.datepicker-wrapper {
		width: 140px !important;
	}

		.datepicker-wrapper {
			position: relative;
			width: 140px !important;
		}
	.input-desc {
		width: 100% !important;
	}

	}

	@@media (max-width: 767px) {
		.filter-item

	{
		grid-template-columns: 90px 100px 1fr;
	}

	.filter-item label {
		width: 90px;
	}

	.filter-item select,
	.filter-item .select2-container
	.datepicker-wrapper {
		width: 100px !important;
	}

		.datepicker-wrapper {
			position: relative;
			width: 100px !important;
		}
	.input-desc {
		width: 100% !important;
	}

	}

	#tableID th, #tableID td {
		white-space: nowrap !important;
	}

/* 
	.dataTables_scrollHead table.dataTable thead th {
		padding: 6px 10px !important;
		white-space: nowrap;
	}
 */
	/*fixed columns style*/
	table.dataTable th,
	table.dataTable td {
		white-space: nowrap;
	}
/* 
	.dtfc-fixed-start,
	.dtfc-fixed-left {
		background-color: rgb(50, 118, 177) !important;
		z-index: 3 !important;
	} */

	.row-abnormal {
		background-color: yellow !important;
	}

	.text-abnormal td {
		color: #ff4a56 !important;
		font-weight: 800;
		font-weight:bolder;
	}
	/* Header fixed column tetap mengikuti warna header utama */
	/* table.dataTable thead .dtfc-fixed-start,
	table.dataTable thead .dtfc-fixed-left {
		background-color: rgb(50, 118, 177) !important;
		color: #fff;
	}*/

	/*Baris abnormal pada kolom fixed */
	/* table.dataTable tbody tr.row-abnormal .dtfc-fixed-start,
	table.dataTable tbody tr.row-abnormal .dtfc-fixed-left {
		background-color: yellow !important;
	} */



	.table > thead {
		vertical-align: bottom;
		line-height: 1.5;
	}

	.table > :not(caption) > * > * {
		padding: .2rem .1rem;
		color: var(--bs-table-color-state, var(--bs-table-color-type, var(--bs-table-color)));
		background-color: var(--bs-table-bg);
		box-shadow: inset 0 0 0 9999px var(--bs-table-bg-state, var(--bs-table-bg-type, var(--bs-table-accent-bg)));
		vertical-align: middle;
		padding-left: 5px !important;
	}

	div.dataTables_scrollBody {
		border: 1px solid lightgray !important;
	}

	.select2-selection__clear {
		display: none !important;
	}

	.select2.select2-container .selection .select2-selection.select2-selection--multiple, .select2.select2-container .selection .select2-selection.select2-selection--single {
		border-color: var(--bs-component-border-color);
		border: 1px solid lightgray !important;
		outline: 0;
		height: calc(1.5em + .875rem + 2px);
		display: flex;
		align-items: center;
		border-radius: 5px !important;
	}


</style>
@section Scripts {
	<script asp-append-version="true">
		window.userPermission = {
			statusAdmin: @(ViewBag.Permission?.StatusAdmin),
			allowUpdate: @(ViewBag.Permission?.AllowUpdate),
			allowDelete: @(ViewBag.Permission?.AllowDelete),
			allowApprove: @(ViewBag.Permission?.AllowApprove)
		};
	</script>
	<script src="~/assets/js/pages/InspectionDataInquiry.js" asp-append-version="true"></script>
}