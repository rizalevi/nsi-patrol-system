@{
	Layout = "_Layout";

}


<div class="panel panel-inverse" >
	<div class="panel-heading theme-color">
		<h4 class="panel-title fs-5"><i class="bi bi-sign-stop"></i> [@ViewBag.Permission.MenuId] - @ViewBag.Permission.MenuName</h4>
		<div class="panel-heading-btn">
			<a href="javascript:;" class="btn btn-xs btn-icon btn-default panel-border-white" data-toggle="panel-expand"><i class="fa fa-expand"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-success panel-border-white" data-toggle="panel-reload"><i class="fa fa-redo"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-warning panel-border-white" data-toggle="panel-collapse"><i class="fa fa-minus"></i></a>
		</div>
	</div>

	<div class="panel-body">
		<div class="row">
			<div class="panel-heading col-md-10">
				<div class="row">
					<div class="row mb-2">
						<div class="col-lg-5 col-md-12">
							<div class="filter-item">
								<label>Cluster</label>
								<select id="ClusterCode" name="ClusterCode" class="form-select fs-13px">
								</select>
								<input id="ClusterName" class="form-control input-desc fs-13px" type="text" readonly placeholder="Cluster Name" />
							</div>
						</div>
						<div class="col-lg-5 col-md-12">
							<div class="filter-item">
								<label>Course</label>
								<select id="CourseCode" name="CourseCode" class="form-select fs-13px">
								</select>
								<input id="CourseName" class="form-control input-desc fs-13px" type="text" readonly placeholder="Course Name" />
							</div>
						</div>
					</div>
					<div class="row mb-2">
						<div class="col-lg-5 col-md-12">
							<div class="filter-item">
								<label>Plant</label>
								<select id="PlantCode" name="PlantCode" class="form-select fs-13px">
									<option value="">Fill a Plant</option>
								</select>
								<input id="PlantName" class="form-control input-desc fs-13px" type="text" readonly placeholder="Plant Name" />

							</div>
						</div>
						<div class="col-lg-5 col-md-12">
							<div class="filter-item">
								<label>Group</label>
								<select id="GroupCode" name="GroupCode" class="form-select fs-13px">
									<option value="">Fill a Group</option>
								</select>
								<input id="GroupName" class="form-control input-desc fs-13px" type="text" readonly placeholder="Group Name" />
								<!-- NAV PREV NEXT BUTTON -->
								@Html.Partial("~/Views/PartialView/_NavButtons.cshtml")
							</div>
						</div>
					</div>
					
				</div>

			</div>

		</div>

		<div class="btn-common-panel">
			<div style="display:flex; gap:10px;">
				@if (ViewBag.Permission.AllowUpdate == "0")
				{
					<button class="btn btn btn-success w-80px me-15px fs-11px btn-add" type="button" disabled>
						<i class="fa fa-plus"></i> New
					</button>
				}
				else
				{
					<button class="btn btn btn-success btn-sm fs-11px btn-add" type="button" onclick="AddNewData(0)">
						<i class="fa fa-plus"></i> New
					</button>
				}
				<button id="btnSearch" class="btn btn-primary btn-sm fs-11px btn-search" type="button"><i class="fa fa-search"></i> Browse</button>
				<button id="btnClear" class="btn btn-secondary btn-sm fs-11px btn-clear" type="button"><i class="fa fa-refresh"></i> Clear</button>
			</div>
			<!--search wajib-->
			<div class="smart-search">
				<i class="fa fa-search"></i>
				<input type="text" class="dt-search" data-table="#tableID" placeholder="Search..." />
			</div>
		</div>

		<!-- PANEL BODY -->
		<div class="table-responsive">
			<table id="tableID" class="table table-striped table-bordered w-100 fs-13px">
				<thead>
					<tr role="row">
						<th style="text-align:center;width:100px" rowspan="2">
							Action
						</th>
						<th style="text-align:center;width:150px" rowspan="2">
							Inspection Code
						</th>
						<th style="text-align:center;width:250px" rowspan="2">
							Inspection Point
						</th>
						<th style="text-align:center;width:150px" rowspan="2">
							Unit
						</th>
						<th style="text-align:center;max-width:150px" colspan="2" class="range">
							Range
						</th>
						<th style="text-align:center;width:150px" rowspan="2">
							Chart Type
						</th>
						<th style="text-align:center;width:150px" rowspan="2">
							Status
						</th>
						<th style="text-align:center;width:150px" rowspan="2">
							Register Date
						</th>
						<th style="text-align:center;width:150px" rowspan="2">
							Register User
						</th>
						<th style="text-align:center;width:150px" rowspan="2">
							Last Update
						</th>
						<th style="text-align:center;width:150px" rowspan="2">
							Last User
						</th>
					</tr>
					<tr class="range">
						<th style="text-align:center;max-width:75px;">
							Minimum
						</th>
						<th style="text-align:center;max-width:75px;">
							Maximum
						</th>
					</tr>
				</thead>

				<tbody></tbody>

			</table>

		</div>
	</div>

	<div class="modal fade" id="MyModal" data-bs-backdrop="static" data-bs-keyboard="false" >
		<div class="modal-dialog modal-dialog-centered" style="--bs-modal-width:700px !important;">
			<div class="modal-content">

				<div class="modal-header  theme-color">
					<h5 class="modal-title" id="ModalTitle">Add New Inspection Point</h5>
					<button type="button" class="btn-close bg-white-200" data-bs-dismiss="modal"></button>
				</div>

				<div class="modal-body" >
					<div class="panel-body">
						<form id="form">
							<div class="form-group row" style="margin-bottom:10px;">
								<label for="InspectionCode" class="col-sm-3 col-form-label text-left">Inspection Code</label>
								<div class="col-sm-9">
									<input id="InspectionCode"
										   name="InspectionCode"
										   class="form-control fs-13px"
										   maxlength="25"
										   autocomplete="off"
										   disabled
										   required />
								</div>
							</div>
							<div class="form-group row" style="margin-bottom:10px;">
								<label for="InspectionPoint" class="col-sm-3 col-form-label text-left">Inspection Point<span class="text-danger">*</span></label>
								<div class="col-sm-5">
									<input id="InspectionPoint"
										   name="InspectionPoint"
										   class="form-control fs-13px"
										   maxlength="50"
										   autocomplete="off"
										   required />
								</div>
							</div>
							<div class="form-group row" style="margin-bottom:10px;">
								<label for="Unit" class="col-sm-3 col-form-label text-left">Unit<span class="text-danger">*</span></label>
								<div class="col-sm-4">
									<select id="UnitCode"
											name="UnitCode"
											class="form-select fs-13px me-2"
											required>
										<option value="">Fill a Unit</option>
									</select>
								</div>
							</div>
							<div class="form-group row" style="margin-bottom:10px;">
								<label for="MinimumRange" class="col-sm-3 col-form-label text-left">Minimum Range</label>
								<div class="col-sm-4">
									<input id="MinimumRange"
										   name="MinimumRange"
										   class="form-control fs-13px"
										   maxlength="15"
										   autocomplete="off"
										   oninput="this.value = this.value.replace(/[^0-9.,-]/g, '')"
										   required />
								</div>
							</div>
							<div class="form-group row" style="margin-bottom:10px;">
								<label for="MaximumRange" class="col-sm-3 col-form-label text-left">Maximum Range</label>
								<div class="col-sm-4">
									<input id="MaximumRange"
										   name="MaximumRange"
										   class="form-control fs-13px"
										   maxlength="15"
										   autocomplete="off"
										   oninput="this.value = this.value.replace(/[^0-9.,-]/g, '')"
										   required />
								</div>
							</div>
							<div class="form-group row" style="margin-bottom:10px;">
								<label for="ChartType" class="col-sm-3 col-form-label text-left">Chart Type<span class="text-danger">*</span></label>
								<div class="col-sm-4">
									<select id="ChartType"
											name="ChartType"
											class="form-select fs-13px me-2"
											required>
									</select>
								</div>
							</div>
							<div class="form-group row" style="margin-bottom:10px;">
								<label for="StatusNonActive" class="col-sm-3 col-form-label text-left">Status</label>
								<div class="col-sm-4 d-flex align-items-center">
									<input type="checkbox"
										   id="StatusNonActive"
										   name="StatusNonActive"
										   value="0"
										   checked
										   style="width:20px;height:20px;cursor:pointer;" />
								</div>
							</div>
						</form>
					</div>
					<div class="modal-footer">
						@if (ViewBag.Permission.AllowUpdate == "0")
						{
							<button type="button" class="btn btn-primary w-80px me-15px fs-11px " id="InsertData" disabled="disabled">Save</button>
							<button type="button" class="btn btn-primary w-80px me-15px fs-11px " id="UpdateData" disabled="disabled" style="display:none;">Update</button>
						}
						else
						{
							<button type="button" class="btn btn-primary w-80px me-15px fs-11px " id="InsertData">Save</button>
							<button type="button" class="btn btn-primary w-80px me-15px fs-11px " id="UpdateData" style="display:none;">Update</button>
						}

						<button type="button" class="btn btn-default w-80px me-15px fs-11px" data-bs-dismiss="modal">Close</button>
					</div>

				</div>
			</div>
		</div>
	</div>
</div>

<style>
	

	.auto-width {
		width: calc(attr(maxlength number) * 1ch);
	}

	.numeric-disabled{
		background-color: #e9ecef !important;
		cursor: not-allowed;
		color: #6e7a7a !important;
	}


	.numeric-enabled {
		background-color: white !important;
		color: black;
	}


	.chk-select {
		transform: scale(1.2);
		cursor: pointer;
	}

	.form-group input {
		border-radius: 5px !important;
	}

	.form-group select {
		border-radius: 5px !important;
	}

	.table > :not(caption) > * > * {
		padding: .2rem .1rem;
		color: var(--bs-table-color-state, var(--bs-table-color-type, var(--bs-table-color)));
		background-color: var(--bs-table-bg);
		box-shadow: inset 0 0 0 9999px var(--bs-table-bg-state, var(--bs-table-bg-type, var(--bs-table-accent-bg)));
		vertical-align: middle;
		padding-left: 5px !important;
	}

	div.dataTables_scrollBody {
		border: 1px solid lightgray !important;
	}

	.select2-selection__clear {
		display: none !important;
	}

	.select2.select2-container .selection .select2-selection.select2-selection--multiple, .select2.select2-container .selection .select2-selection.select2-selection--single {
		border-color: var(--bs-component-border-color);
		border: 1px solid lightgray !important;
		outline: 0;
		height: calc(1.5em + .875rem + 2px);
		display: flex;
		align-items: center;
		border-radius: 5px !important;
	}

	/* =========================================================
	   FILTER ROW
	========================================================= */

	.filter-row {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		width: 100%;
		min-width: 0;
	}

		.filter-row > * {
			min-width: 0;
		}


	/* =========================================================
	   COMMON BUTTON PANEL
	========================================================= */

	.btn-common-panel {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		width: 100%;
		min-width: 0;
	}

		.btn-common-panel > div:first-child {
			display: flex;
			align-items: center;
			gap: 10px;
			flex-wrap: wrap;
			min-width: 0;
		}

		.btn-common-panel .btn {
			white-space: nowrap;
		}

		.smart-search {
			max-width: 100%;
		}

		.smart-search input {
			max-width: 100%;
		}


	/* =========================================================
	   >= 1900
	   LARGE DESKTOP
	========================================================= */


	@@media (min-width: 1901px) {
		.filter-item {
			display: grid;
			grid-template-columns: 100px 150px minmax(0, 200px);
			align-items: center;
			gap: 10px;
			width: 100%;
			min-width: 0;
		}

			.filter-item label {
				width: 100px;
			}

			.filter-item select,
			.filter-item .select2-container,
			.datepicker-wrapper {
				width: 150px !important;
				max-width: 150px;
			}

		.smart-search {
			width: 240px;
			max-width: 100%;
		}

		/* =========================================
		   GROUP + PREV/NEXT
		========================================= */

		.filter-item:has(#GroupCode) {
			grid-template-columns: 100px 150px 150px auto;
		}

			.filter-item:has(#GroupCode) .btn-prev,
			.filter-item:has(#GroupCode) .btn-next {
				width: 80px;
				height: 30px;
				margin: 0;
				border: 1px solid lightgray !important;
				font-size: 11px !important;
			}
	}

	/* =========================================================
	   1360 - 1599
	========================================================= */

	@@media (min-width: 1360px) and (max-width: 1899px) {
		.filter-item {
			display: grid;
			grid-template-columns: 100px 150px minmax(0, 150px);
			align-items: center;
			gap: 10px;
			width: 100%;
			min-width: 0;
		}

			.filter-item label {
				width: 100px;
			}

			.filter-item select,
			.filter-item .select2-container,
			.datepicker-wrapper {
				width: 150px !important;
				max-width: 150px;
			}

		.smart-search {
			width: 240px;
			max-width: 100%;
		}

		/* =========================================
			   GROUP + PREV/NEXT
			========================================= */

		.filter-item:has(#GroupCode) {
			grid-template-columns: 100px 150px 150px auto;
		}

			.filter-item:has(#GroupCode) .btn-prev,
			.filter-item:has(#GroupCode) .btn-next {
				width: 80px;
				height: 30px;
				margin: 0;
				border: 1px solid lightgray !important;
				font-size: 11px !important;
			}

		
	}

	/* =========================================================
	   1280 - 1359
	========================================================= */

	@@media (min-width: 1280px) and (max-width: 1359px) {
		.filter-item {
			grid-template-columns: 90px 150px minmax(0, 180px);
		}

			.filter-item label {
				width: 90px;
			}

			.filter-item select,
			.filter-item .select2-container,
			.datepicker-wrapper {
				width: 150px !important;
				max-width: 150px;
			}

		.smart-search {
			width: 220px;
			max-width: 100%;
		}

		.btn-common-panel .btn {
			font-size: 11px;
		}

		
	}

	/* =========================================================
	   768 - 1023
	   TABLET
	========================================================= */

	@@media (min-width: 768px) and (max-width: 1279px) {
		.filter-item {
			display: grid;
			grid-template-columns: 90px minmax(0, 1fr);
			grid-template-rows: auto auto;
			column-gap: 8px;
			row-gap: 5px;
			width: 100%;
			max-width: 100%;
			min-width: 0;
			box-sizing: border-box;
		}

			.filter-item label {
				grid-column: 1;
				grid-row: 1 / span 2;
				width: 90px;
				min-width: 0;
				align-self: start;
				margin-top: 7px;
				white-space: nowrap;
			}
			/* SELECT */
			.filter-item select,
			.filter-item .select2-container {
				grid-column: 2;
				grid-row: 1;
				width: 100% !important;
				max-width: 100% !important;
				min-width: 0;
			}
			/* DESCRIPTION */
			.filter-item .input-desc {
				grid-column: 2;
				grid-row: 2;
				width: 100% !important;
				max-width: 100% !important;
				min-width: 0;
				box-sizing: border-box;
			}
		/* SEARCH */
		.smart-search {
			width: 180px;
			max-width: 100%;
		}
	}

	/* =========================================================
	   MOBILE
	   <= 767px
	========================================================= */
	@@media (max-width: 767px) {
		.panel-body {
			width: 100%;
			max-width: 100%;
			overflow-x: hidden;
			box-sizing: border-box;
		}

			.panel-body > .row {
				margin-left: 0;
				margin-right: 0;
			}

			.panel-body .row {
				max-width: 100%;
				min-width: 0;
			}

		.filter-row {
			display: flex;
			flex-direction: column;
			gap: 8px;
			width: 100%;
			max-width: 100%;
		}

		.panel-body .row.mb-2 {
			margin-left: 0;
			margin-right: 0;
		}
		/* FILTER */
		.filter-item {
			display: grid;
			grid-template-columns: 90px minmax(0, 1fr);
			column-gap: 8px;
			row-gap: 6px;
			width: 100%;
			max-width: 100%;
			min-width: 0;
			box-sizing: border-box;
		}

			.filter-item label {
				grid-column: 1;
				width: 90px;
				min-width: 0;
				font-size: 12px;
				line-height: 1.2;
				white-space: nowrap;
				margin: 0;
			}
			/* SELECT */
			.filter-item select,
			.filter-item .select2-container {
				grid-column: 2;
				width: 100% !important;
				max-width: 100% !important;
				min-width: 0;
			}
			/* DESCRIPTION */
			.filter-item .input-desc {
				grid-column: 2;
				width: 100% !important;
				max-width: 100% !important;
				min-width: 0;
				box-sizing: border-box;
			}
			/* DATE */
			.filter-item .datepicker-wrapper {
				grid-column: 2;
				width: 100% !important;
				max-width: 100% !important;
				min-width: 0;
				box-sizing: border-box;
			}

		.datepicker-wrapper input {
			width: 100%;
			max-width: 100%;
		}
		/* SEARCH */
		.smart-search {
			width: 100%;
			max-width: 100%;
			min-width: 0;
			box-sizing: border-box;
		}

			.smart-search input {
				width: 100%;
				max-width: 100%;
				min-width: 0;
				box-sizing: border-box;
			}
		/* BUTTON */
		.btn-common-panel {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			width: 100%;
			max-width: 100%;
			gap: 8px;
			box-sizing: border-box;
		}

			.btn-common-panel > div:first-child {
				display: flex !important;
				flex-wrap: wrap;
				width: 100%;
				max-width: 100%;
				gap: 6px !important;
				box-sizing: border-box;
			}

				.btn-common-panel > div:first-child .btn {
					flex: 1 1 auto;
					min-width: 0;
					white-space: nowrap;
				}
		/* TABLE */
		.table-responsive {
			width: 100%;
			max-width: 100%;
			overflow-x: auto !important;
			overflow-y: hidden;
			box-sizing: border-box;
			-webkit-overflow-scrolling: touch;
		}

			.table-responsive table {
				max-width: none;
			}

		div.dataTables_scrollBody {
			max-width: 100% !important;
			overflow-x: auto !important;
		}
	}
</style>
<style>

	.panel.panel-inverse {
		min-height: 86vh !important;
	}

	@@media (min-width: 1900px) {
		.panel.panel-inverse {
			min-height: 86vh !important;
		}

		.dataTables_scrollBody, .dt-scroll-body {
			height: calc(45vh) !important;
			max-height: calc(45vh) !important;
			min-height: calc(45vh) !important;
		}
	}

	@@media (max-width: 1528px) {

		.dataTables_scrollBody, .dt-scroll-body {
			height: calc(35vh) !important;
			max-height: calc(35vh) !important;
			min-height: calc(35vh) !important;
		}

		.panel.panel-inverse {
			height: 82vh !important;
			min-height: 82vh !important;
		}
	}


	/* =========================================================
	   HIDE PREV / NEXT
	   BELOW 1360px
	========================================================= */

	@@media (max-width: 1359px) {
		.btn-prev, .btn-next {
			display: none !important;
		}
	}
</style>

@section Scripts {
	<script asp-append-version="true">
		window.userPermission = {
			statusAdmin: @(ViewBag.Permission?.StatusAdmin),
			allowUpdate: @(ViewBag.Permission?.AllowUpdate),
			allowDelete: @(ViewBag.Permission?.AllowDelete),
			allowApprove: @(ViewBag.Permission?.AllowApprove)
		};
	</script>
	<script src="~/assets/js/pages/msinspectionpoint.js" asp-append-version="true"></script>

}