<!DOCTYPE html>

<html>
<head>
    <title>Inspection Report</title>

```
<style>
    body {
        font-family: 'Trebuchet MS', Arial;
        margin: 0;
    }

    .toolbar {
        padding: 10px;
        display: flex;
        gap: 10px;
    }

    .btn {
        padding: 6px 12px;
        border: none;
        cursor: pointer;
        color: #fff;
    }

    .btn-print { background: #dc3545; }
    .btn-pdf { background: #28a745; }

    /* REPORT STYLE */
    .report {
        width: 1000px;
        margin: auto;
        border: 1px solid black;
        padding: 10px;
    }

    .header {
        text-align: center;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .sub-header {
        font-size: 12px;
        margin-bottom: 10px;
    }

    .flex {
        display: flex;
        gap: 10px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
    }

    th, td {
        border: 1px solid black;
        padding: 4px;
        text-align: center;
    }

    th {
        background: #f0f0f0;
    }

    /* PRINT STYLE */
    @@media print {
        .toolbar {
            display: none;
        }

        @@page {
            size: A4;
            margin: 10mm;
        }

        .report {
            width: 100%;
            border: none;
        }
    }
</style>
```

</head>

<body>

<div class="toolbar">
    <button class="btn btn-print" onclick="printReport()">Print</button>
    <button class="btn btn-pdf" onclick="downloadPDF()">Export PDF</button>
</div>

<div id="report" class="report">

```
<div class="header">
