@{
	Layout = "_Layout";

}
<div class="panel panel-inverse">
	<div class="panel-heading theme-color">
		<h4 class="panel-title fs-5"><i class="bi bi-sign-stop"></i> [@ViewBag.Permission.MenuId] - @ViewBag.Permission.MenuName</h4>
		<div class="panel-heading-btn">
			<a href="javascript:;" class="btn btn-xs btn-icon btn-default panel-border-white" data-toggle="panel-expand"><i class="fa fa-expand"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-success panel-border-white" data-toggle="panel-reload"><i class="fa fa-redo"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-warning panel-border-white" data-toggle="panel-collapse"><i class="fa fa-minus"></i></a>
		</div>
	</div>

	<div class="panel-body">

		<div class="btn-common-panel">
			<!-- LEFT: BUTTON GROUP -->
			<div style="display:flex; gap:10px;">
				@if (ViewBag.Permission.AllowUpdate == "0")
				{
					<button id="btnadd" class="btn btn-success btn-sm  fs-13px btn-addnew" type="button" disabled><i class="fa fa-plus"></i> New</button>
				}
				else
				{
					<button id="btnadd" class="btn btn-success btn-sm  fs-13px btn-addnew" type="button"><i class="fa fa-plus"></i> New</button>
				}
			</div>
			<!--search wajib-->
			<div class="smart-search">
				<i class="fa fa-search"></i>
				<input type="text" class="dt-search" data-table="#tableID" placeholder="Search..." />
			</div>
		</div>
		<!-- PANEL BODY -->
		<div class="table-responsive">
			<table id="tableID" class="table table-striped table-bordered w-100" border="1">

				<thead>
					<tr>
						<th style="text-align:center;width:130px">
							Action
						</th>
						<th style="text-align:center;width:130px">
							Device Code
						</th>
						<th style="text-align:center;width:200px">
							Device Name
						</th>
						<th style="text-align:center;width:120px">
							Plant Code
						</th>
						<th style="text-align:center;width:350px">
							Plant
						</th>
						<th style="text-align:center;width:150px">
							Serial No
						</th>
						<th style="text-align:center;width:150px">
							Register Date
						</th>
						<th style="text-align:center;width:150px">
							Register User
						</th>
						<th style="text-align:center;width:150px">
							Last Update
						</th>
						<th style="text-align:center;width:150px">
							Last User
						</th>
					</tr>
				</thead>

				<tbody></tbody>

			</table>

			<div class="modal fade" id="MyModal" data-bs-backdrop="static" data-bs-keyboard="false">
				<div class="modal-dialog modal-dialog-centered" style="--bs-modal-width:600px !important;">
					<div class="modal-content" >
						<div class="modal-header  theme-color">
							<h5 class="modal-title" id="ModalTitle">Add New Device</h5>
							<button type="button" class="btn-close bg-white-200" data-bs-dismiss="modal"></button>
						</div>
						<div class="modal-body">
							<div class="panel-body">
								<form id="form">
									<div class="row">
										<div class="row mb-2">
											<div class="col-lg-12 col-md-12">
												<div class="filter-item">
													<label for="DeviceCode">Device Code <span class="text-danger">*</span></label>
													<div class="col-sm-9">
														<input id="DeviceCode" name="DeviceCode" class="form-control fs-13px" maxlength="10" autocomplete="off" placeholder="Device Code" />
													</div>
												</div>
											</div>

										</div>
										<div class="row mb-2">
											<div class="col-lg-12 col-md-12">
												<div class="filter-item">
													<label for="DeviceName" >Device Name <span class="text-danger">*</span></label>
													<div class="col-sm-9">
														<input id="DeviceName" name="DeviceName" class="form-control fs-13px" maxlength="30" autocomplete="off" placeholder="Device Name" />
													</div>
												</div>
											</div>
										</div>
										<div class="row mb-2">
											<div class="col-lg-12 col-md-12">
												<div class="filter-item">
													<label for="PlantCode">
														Plant <span class="text-danger">*</span>
													</label>

													<select id="PlantCode" name="PlantCode" class="form-select"></select>
													<input id="PlantName" name="PlantName" class="form-control input-desc" style="margin-left:10px;width:250px" type="text" readonly placeholder="Plant Name" />

												</div>
											</div>
										</div>
										<div class="row mb-2">
											<div class="col-lg-12 col-md-12">
												<div class="filter-item">
													<label for="SerialNo" >Serial No<span class="text-danger">*</span></label>
													<div class="col-sm-9">
														<input id="SerialNo" name="SerialNo" class="form-control fs-13px" maxlength="30" autocomplete="off" placeholder="Serial No" />
													</div>
												</div>
											</div>
										</div>

									</div>
									
								</form>
							</div>
							<div class="modal-footer">
								@if (ViewBag.Permission.AllowUpdate == "0")
								{
									<button type="button" class="btn btn-primary" id="InsertData" disabled="disabled">Save</button>
									<button type="button" class="btn btn-primary" id="UpdateData" disabled="disabled" style="display:none;">Update</button>
								}
								else
								{
									<button type="button" class="btn btn-primary" id="InsertData">Save</button>
									<button type="button" class="btn btn-primary" id="UpdateData" style="display:none;">Update</button>
								}

								<button type="button" class="btn btn-default" data-bs-dismiss="modal">Close</button>
							</div>

						</div>
					</div>
				</div>
			</div>
				
				<div class="modal fade" id="ModalDeviceDetail" data-bs-backdrop="static" data-bs-keyboard="false">
				<div class="modal-dialog modal-dialog-centered" style="--bs-modal-width:900px !important;">
						<div class="modal-content">
							<div class="modal-header  theme-color">
								<h5 class="modal-title" id="ModalTitle">Device Setting</h5>
								<button type="button" class="btn-close bg-white-200" data-bs-dismiss="modal"></button>
							</div>
						<div class="modal-body" >
								<div class="panel-body">
								<form id="form">
									<div style="border:1px solid lightgray; padding:5px; margin-top:5px">
										<div class="form-group row" style="margin-bottom:10px;">
											<label for="CodeSettings" class="col-sm-2 col-form-label text-left">Device Code</label>
											<div class="col-sm-2">
													<select id="CodeSettings" name="CodeSettings" class="form-select fs-13px me-2 sWidth-ddl">
													<option value="">Fill a Device Code</option>
												</select>
											</div>
											<div class="col-sm-3" style="margin-left:15px">
												<input id="CodeSettingsName" name="CodeSettingsName" class="form-control input-desc  fs-13px" maxlength="30" autocomplete="off" placeholder="Settings Name" />
											</div>
										</div>
										<div class="form-group row" style="margin-bottom:10px;">
											<label for="PlantCodeSettings" class="col-sm-2 col-form-label text-left">Plant Code</label>
											<div class="col-sm-2">
													<select id="PlantCodeSettings" name="PlantCodeSettings" class="form-select fs-13px me-2 sWidth-ddl">
														<option value="">Fill a Plant Code</option>
												</select>
											</div>
											<div class="col-sm-3" style="margin-left:15px">
												<input id="PlantNameSettings" name="PlantNameSettings" class="form-control input-desc  fs-13px"  maxlength="30" autocomplete="off" />
											</div>
										</div>
									</div>
									<div class="btn-common-panel">
										<div style="display:flex; gap:10px;">
											@if (ViewBag.Permission.AllowUpdate == "0")
											{
												<button type="button" class="btn btn-primary btn-submitdetail" disabled> <i class="fa fa-save"></i> Save Settings</button>
											}
											else
											{
												<button type="button" class="btn btn-primary btn-submitdetail"> <i class="fa fa-save"></i> Save Settings</button>

											}
										</div>

									</div>
									<div class="table-responsive" style="margin-top:15px;">
													<table id="tableDetail" class="table table-striped table-bordered w-100" border="1">
											<thead>
												<tr>
													<th style="text-align:center;width:120px">Action</th>
													<th style="text-align:center;width:150px">Plant</th>
													<th style="text-align:center;width:180px">Course</th>
													<th style="text-align:center;width:450px">Title</th>
												</tr>
											</thead>
											<tbody></tbody>
										</table>
									</div>
								</form>

							</div>


						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
		div.dataTables_scrollBody {
			border: 1px solid lightgray !important;
		}

		#tableID .dataTables_scrollBody {
			border: none !important;
			overflow-x: auto !important;
			overflow-y: auto !important;
			/* height: calc(105vh - 398px) !important;
			max-height: calc(105vh - 398px) !important; */
			-webkit-overflow-scrolling: touch;
		}

		.form-row input, select {
			border-radius: 5px !important;
		}

		.dataTables_wrapper > .row:first-child {
			display: flex !important;
			flex-direction: row !important;
			flex-wrap: nowrap !important;
			justify-content: space-between !important;
			align-items: center !important;
		}

		#btn-placeholder {
			width: auto;
			text-align: left;
			margin: 0 !important;
			padding: 0 !important;
			line-height: 1 !important;
		}

			#btn-placeholder .btn {
				width: auto !important;
				display: inline-block !important;
				margin: 0 !important;
				padding: 4px 12px !important;
			}



		.table > thead {
			vertical-align: bottom;
			line-height: 2;
		}

		.table > :not(caption) > * > * {
			padding: .3rem .1rem;
			color: var(--bs-table-color-state, var(--bs-table-color-type, var(--bs-table-color)));
			background-color: var(--bs-table-bg);
			border-bottom-width: 1px;
			box-shadow: inset 0 0 0 9999px var(--bs-table-bg-state, var(--bs-table-bg-type, var(--bs-table-accent-bg)));
			vertical-align: middle;
			padding-left: 5px !important;
		}

		
    .select2-selection__clear {
        display: none !important;
    }

		.select2.select2-container .selection .select2-selection.select2-selection--multiple, .select2.select2-container .selection .select2-selection.select2-selection--single {
			border-color: var(--bs-component-border-color);
			border: 1px solid lightgray !important;
			outline: 0;
			height: calc(1.5em + .875rem + 2px);
			display: flex;
			align-items: center;
			border-radius: 5px !important;
		}

	.filter-item {
		display: grid;
		grid-template-columns: 100px 150px 250px;
		align-items: center;
		gap: 10px;
	}

		.filter-item label {
			width: 100px;
			min-width: 100px;
			margin-bottom: 0;
		}
	/*
						.filter-item select {
							width: 180px;
						}*/

	.input-desc {
		width: 100% !important;
	}

	



	/* =======================================================
						   1920+
	======================================================= */
	@@media (min-width: 1900px) {
		.filter-item {
			grid-template-columns: 100px 150px 250px;
			gap: 10px;
		}

			.filter-item select, .filter-item .select2-container .datepicker-wrapper {
				width: 150px !important;
			}

	}
	</style>
	<style>
		.panel.panel-inverse {
			min-height: 86vh;
		}

		@@media (max-width: 1528px) {
			.panel.panel-inverse
			{
			height: 82vh;
				min-height: 82vh;
			}

			#tableID th:nth-child(1),
			#tableID td:nth-child(1) {
				width: 100px !important;
				min-width: 100px !important;
			}

			#tableID th:nth-child(2),
			#tableID td:nth-child(2) {
				width: 100px !important;
				min-width: 100px !important;
			}

			#tableID th:nth-child(3),
			#tableID td:nth-child(3) {
				width: 160px !important;
				min-width: 160px !important;
			}

			#tableID th:nth-child(4),
			#tableID td:nth-child(4) {
				width: 100px !important;
				min-width: 100px !important;
			}

			#tableID th:nth-child(5),
			#tableID td:nth-child(5) {
				width: 280px !important;
				min-width: 280px !important;
			}

			#tableID th:nth-child(6),
			#tableID td:nth-child(6) {
				width: 130px !important;
				min-width: 130px !important;
			}

			#tableID th:nth-child(7),
			#tableID td:nth-child(7) {
				width: 130px !important;
				min-width: 130px !important;
			}

			#tableID th:nth-child(8),
			#tableID td:nth-child(8) {
				width: 130px !important;
				min-width: 130px !important;
			}

			#tableID th:nth-child(9),
			#tableID td:nth-child(9) {
				width: 130px !important;
				min-width: 130px !important;
			}

			#tableID th:nth-child(10),
			#tableID td:nth-child(10) {
				width: 130px !important;
				min-width: 130px !important;
			}
		}
	</style>
@section Scripts {
	<script asp-append-version="true">
		window.userPermission = {
			statusAdmin: @(ViewBag.Permission?.StatusAdmin),
			allowUpdate: @(ViewBag.Permission?.AllowUpdate),
			allowDelete: @(ViewBag.Permission?.AllowDelete),
			allowApprove: @(ViewBag.Permission?.AllowApprove)
		};
	</script>

	<script src="~/assets/js/pages/MSDevice.js" asp-append-version="true"></script>


}