@{
    Layout = null;

    var controller = ViewBag.RedirectController?.ToString();
    var token = ViewBag.Token?.ToString();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Redirecting...</title>

    <style>
        body {
            font-family: Arial;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .loading {
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="loading">
        <h3>Redirecting...</h3>
        <p>Please wait...</p>
    </div>

    <script>
        setTimeout(function () {
            window.location.href =
                '/@controller/Email?token=@token';
        }, 200);
    </script>

</body>
</html>