@{
	Layout = "_Layout";
}


<div class="panel panel-inverse" style="min-height:86vh;">
	<div class="panel-heading theme-color">
		<h4 class="panel-title fs-5"><i class="bi bi-sign-stop"></i> [@ViewBag.Permission.MenuId] - @ViewBag.Permission.MenuName</h4>
		<div class="panel-heading-btn">
			<a href="javascript:;" class="btn btn-xs btn-icon btn-default panel-border-white" data-toggle="panel-expand"><i class="fa fa-expand"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-success panel-border-white" data-toggle="panel-reload"><i class="fa fa-redo"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-warning panel-border-white" data-toggle="panel-collapse"><i class="fa fa-minus"></i></a>
		</div>
	</div>
	<div class="panel-body">
		<div class="row">
			<div class="panel-heading col-md-10">
				<div class="row">
					<div class="row mb-2">
						<div class="col-lg-5 col-md-12">
							<!-- Cluster -->
							<div class="filter-item">
								<label>Cluster</label>
								<select id="ClusterCode" name="ClusterCode" class="form-select" >
									<option value="">Fill a Cluster</option>
								</select>
								<input id="ClusterName" class="form-control input-desc" type="text" readonly placeholder="Cluster Name" />
							</div>
						</div>

						<div class="col-lg-5 col-md-12">
							<!-- Frequency -->
							<div class="filter-item">
								<label>Frequency</label>
								<select id="Frequency" name="Frequency" class="form-select">
									<option value="">Fill a Frequency</option>
								</select>

							</div>
						</div>
					</div>
					<div class="row mb-2">
						<div class="col-lg-5 col-md-12">
							<!--plant-->
							<div class="filter-item">
								<label>Plant</label>
								<select id="PlantCode" name="PlantCode" class="form-select">
									<option value="">Fill a Plant</option>
								</select>
								<input id="PlantName" class="form-control input-desc" type="text" readonly placeholder="Plant Name" />

							</div>
						</div>
						<div class ="col-lg-5 col-md-12">
								<!--inspection date -->
								<div class="filter-item">
									<label>Inspection Date</label>
									<div class="datepicker-wrapper">
									<input id="InspectionDateFrom" name="InspectionDateFrom" type="text" class="form-control datepicker" autocomplete="off" style="height:35px" />
										<span class="datepicker-icon">
											<i class="fa fa-calendar"></i>
										</span>
									</div>
								
									<div class="datepicker-wrapper">
									<input id="InspectionDateTo" name="InspectionDateTo" type="text" class="form-control datepicker" autocomplete="off" style="height:35px" />
										<span class="datepicker-icon">
											<i class="fa fa-calendar"></i>
										</span>
									</div>
								</div>
								
						</div>

					</div>
					<div class="row mb-2">
						<div class="col-lg-6 col-md-12">
							<div class="filter-item">
								<label>Course</label>
								<select id="CourseCode" name="CourseCode" class="form-select">
									<option value="">Fill a Course</option>
								</select>
								<input id="CourseName" class="form-control input-desc" type="text" readonly placeholder="Course Name" />
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="btn-common-panel">
			<div style="display:flex; gap:10px;">
				<form id="formBack" method="post" action="/TasklistRemaining/index" style="display:inline;">

					<button type="submit" class="btn btn-danger btn-sm fs-11px btn-back hidden">
						<i class="fa fa-arrow-left"></i>&nbsp;  Back
					</button>
				</form>
				<button class="btn btn-primary btn-sm fs-11px  btn-search"><i class="fa fa-search"></i> Browse</button>
				<button class="btn btn-secondary btn-sm fs-11px btn-clear"><i class="fa fa-refresh"></i> Clear</button>
				@if (ViewBag.Permission.AllowUpdate == "0")
				{
					<button class="btn btn-primary btn-sm fs-11px btn-submit" disabled><i class="fa fa-check"></i> Approve</button>
				}
				else
				{
					<button class="btn btn-primary btn-sm fs-11px btn-submit"><i class="fa fa-check"></i> Approve</button>
				}
				@*  <button class="btn btn-success btn-sm btn-excel"><i class="fa fa-excel"></i> Excel</button> *@
			</div>

			<!-- RIGHT: SEARCH -->
			<div class="smart-search">
				<i class="fa fa-search"></i>
				<input type="text" class="dt-search" data-table="#tableID" placeholder="Search..." />
			</div>
		</div>

		<!-- PANEL BODY -->
		<div class="table-responsive">
			<table id="tableID" class="table table-striped table-bordered w-100 fs-13px" style="min-width:2000px">
				<thead>
					<tr role="row">

						<th rowspan="2" style="text-align:center;min-width:100px;">
							Plant
						</th>
						<th rowspan="2" style="text-align:center;min-width:150px;">
							Date
						</th>
						<th rowspan="2" style="text-align:center;width:150px;">
							Frequency
						</th>
						<th rowspan="2" style="text-align:center;min-width:150px;">
							Course
						</th>
						<th rowspan="2" style="text-align:center;min-width:250px;">
							Document No
						</th>
						<th colspan="3" style="text-align:center;">
							Inspector
						</th>
						<th colspan="3" style="text-align:center;">
							Leader
						</th>
						<th colspan="3" style="text-align:center;">
							Supervisor
						</th>


					</tr>
					<tr>
						<th style="text-align:center;">
							Check
						</th>
						<th style="text-align:center;">
							Name
						</th>
						<th style="text-align:center;">
							Date
						</th>
						<th style="text-align:center;">
							Check
						</th>
						<th style="text-align:center;">
							Name
						</th>
						<th style="text-align:center;">
							Date
						</th>
						<th style="text-align:center;">
							Approve
						</th>
						<th style="text-align:center;">
							Name
						</th>
						<th style="text-align:center;">
							Date
						</th>

					</tr>

				</thead>
			</table>
		</div>
	</div>


	<div class="modal fade" id="MyModal" data-bs-backdrop="static" data-bs-keyboard="false">
		<div class="modal-dialog modal-dialog-centered" style="--bs-modal-width:1000px !important;height:85vh !important;">
			<div class="modal-content" >

				<div class="modal-header  theme-color">
					<h5 class="modal-title" id="ModalTitle">Inspection Approval Detail</h5>
					<button type="button" class="btn-close bg-white-200" data-bs-dismiss="modal"></button>
				</div>

				<div class="modal-body" >
					<div class="panel-body">
						<div style="border:1px solid lightgray; padding:5px; margin-top:5px" class="row">
							<div class="row mb-2">
								<div class="col-lg-5 col-md-12">
									<div class="filter-item">
										<label>Course</label>
										<input id="Course" class="form-control" type="text" maxlength="18" readonly />

									</div>
								</div>
								<div class="col-lg-5 col-md-12">
									<div class="filter-item">
										<label>Title</label>
										<input id="Title" class="form-control" type="text" maxlength="35" readonly />
									</div>
								</div>
							</div>

							<div class="row mb-2">
								<div class="col-lg-5 col-md-12">
									<div class="filter-item">
										<label>Document No</label>
										<input id="DocumentNo" class="form-control" type="text" maxlength="18" readonly />
									</div>
								</div>
								<div class="col-lg-5 col-md-12">
									<div class="filter-item">
										<label>Inspection Date</label>
										<input id="InspectionDate" class="form-control" type="text" maxlength="15" readonly />
										
										<input id="FrequencyName" class="form-control" type="text" maxlength="15" readonly />
									</div>
								</div>
							</div>
							<div style="display:none;">
								<input id="GroupCodeModal" readonly />
								<input id="InspectionNo" readonly />
							</div>
						</div>

						<div class="btn-common-panel">
							<div style="display:flex; gap:10px;">
								@if (ViewBag.Permission.AllowUpdate == "0")
								{
									<button type="button" class="btn btn-primary btn-approve" disabled><i class="fa fa-check"></i> Approve</button>
								}
								else
								{
									<button type="button" class="btn btn-primary btn-approve"><i class="fa fa-check"></i> Approve</button>
								}
							</div>
							<!-- RIGHT: SEARCH -->
							@*  <div class="smart-search">
                                            <i class="fa fa-search"></i>
                                            <input type="text" id="tabledetailSearch" placeholder="Search..." />
                                        </div> *@

							<div class="smart-search">
								<i class="fa fa-search"></i>
								<input type="text" class="dt-search" data-table="#tableID-Detail" placeholder="Search..." />
							</div>
						</div>


						<div class="table-responsive">
							<table id="tableID-Detail" class="table table-striped table-bordered w-100 fs-13px">
								<thead>
									<tr role="row">
										<th rowspan="2" style="text-align:center;max-width:50px">
										</th>
										<th rowspan="2" style="text-align:center;width:150px">
											Group
										</th>
										<th rowspan="2" style="text-align:center;width:200px">
											Inspection Point
										</th>
										<th rowspan="2" style="text-align:center;width:130px">
											Unit
										</th>
										<th colspan="2" style="text-align:center;max-width:140px">
											Range
										</th>
										<th rowspan="2" style="text-align:center;width:150px">
											Inspection Result
										</th>
										<th rowspan="2" style="text-align:center;width:120px">
											Status
										</th>
										<th rowspan="2" style="text-align:center;width:250px">
											Remarks
										</th>
									</tr>
									<tr>
										<th style="text-align:center;max-width:70px">
											Min
										</th>
										<th style="text-align:center;max-width:70px">
											Max
										</th>
									</tr>
								</thead>
							</table>
						</div>
					</div>

				</div>
			</div>
		</div>

	</div>
</div>
@section Styles {
	<link rel="stylesheet" href="~/assets/css/pages/InspectionDataApproval.css" asp-append-version="true" />
	}
@section Scripts {
	<script>
		var clusterCode = '@ViewData["ClusterCode"]';
		var plantCode = '@ViewData["PlantCode"]';
		var courseCode = '@ViewData["CourseCode"]';
		var groupCode = '@ViewData["GroupCode"]';
		var inspectionDate = '@ViewData["InspectionDate"]';
		var frequency = '@ViewData["Frequency"]';
	</script>
	<script asp-append-version="true">
		window.userPermission = {
			statusAdmin: @(ViewBag.Permission?.StatusAdmin),
			allowUpdate: @(ViewBag.Permission?.AllowUpdate),
			allowDelete: @(ViewBag.Permission?.AllowDelete),
			allowApprove: @(ViewBag.Permission?.AllowApprove)
		};
	</script>
	<script src="~/assets/js/pages/InspectionDataApproval.js" asp-append-version="true"></script>

	}
