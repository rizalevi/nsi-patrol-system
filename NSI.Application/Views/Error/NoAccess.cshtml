@{
    Layout = "_Layout"; // atau null kalau mau standalone
    ViewData["Title"] = "No Access";
}

<div class="d-flex justify-content-center align-items-center" style="height:70vh;">
    <div class="text-center">
        <h1 style="font-size:80px; font-weight:bold; color:#dc3545;">403</h1>
        <h3 class="mb-3">Access Denied</h3>
        <p class="text-muted mb-4">
            You do not have permission to access this menu.
            <br />
            Please contact administrator if you need access.
        </p>
        @if (ViewBag.MenuName != null)
        {
            <p class="text-muted mb-4">
                Menu :@ViewBag.MenuID  -  @ViewBag.MenuName
            </p>
        }


        <a href="/Home/index" class="btn btn-primary">
            Back to Home
        </a>
    </div>
</div>