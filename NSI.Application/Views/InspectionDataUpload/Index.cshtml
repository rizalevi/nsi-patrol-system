@{
	Layout = "_Layout";

}


<div class="panel panel-inverse" style="min-height:86vh;">
	<div class="panel-heading theme-color">
		<h4 class="panel-title fs-5"><i class="bi bi-sign-stop"></i> [@ViewBag.Permission.MenuId] - @ViewBag.Permission.MenuName</h4>
		<div class="panel-heading-btn">
			<a href="javascript:;" class="btn btn-xs btn-icon btn-default panel-border-white" data-toggle="panel-expand"><i class="fa fa-expand"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-success panel-border-white" data-toggle="panel-reload"><i class="fa fa-redo"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-warning panel-border-white" data-toggle="panel-collapse"><i class="fa fa-minus"></i></a>
		</div>
	</div>
	<div class="panel-body">
		<div class="row">
			<div class="panel-heading col-md-10">
				<div class="row">
					<div class="row mb-2">
						<div class="col-lg-5 col-md-12">
							<div class="filter-item">
								<label>Cluster</label>
								<select id="ClusterCode" class="form-select">
									<option>Fill a Cluster</option>
								</select>
								<input id="ClusterName" class="form-control input-desc" readonly />
							</div>
						</div>

						<div class="col-lg-5 col-md-12">
							<div class="filter-item">
								<label>Group</label>
								<select id="GroupCode" class="form-select">
									<option>Fill a Group</option>
								</select>
								<input id="GroupName" class="form-control input-desc" readonly />
							</div>
						</div>

					</div>

					<div class="row mb-2">

						<div class="col-lg-5 col-md-10">
							<div class="filter-item">
								<label>Plant</label>
								<select id="PlantCode" class="form-select">
									<option>Fill a Plant</option>
								</select>
								<input id="PlantName" class="form-control input-desc" readonly />
							</div>
						</div>

						<div class="col-lg-5 col-md-10">
							<!--inspection date -->
							<div class="filter-item">
								<label>Inspection Date</label>
								<div class="datepicker-wrapper">

									<input id="InspectionDateFrom" name="InspectionDateFrom" type="text"  class="form-control datepicker" autocomplete="off" style="height:35px !important; " />
									<span class="datepicker-icon">
										<i class="fa fa-calendar"></i>
									</span>
								</div>
							</div>
						</div>

					</div>

					<div class="row mb-2">
						<div class="col-lg-5 col-md-10">
							<div class="filter-item">
								<label>Course</label>
								<select id="CourseCode" name="CourseCode" class="form-select">
									<option>Fill a Course</option>
								</select>
								<input id="CourseName" class="form-control input-desc" readonly />
							</div>
						</div>


						<div class="col-lg-5 col-md-10">
							<div class="filter-item">
								<label>Frequency</label>
								<select id="Frequency" name="Frequency" class="form-select fs-13px">
									<option value="">Fill a Frequency</option>
								</select>
							</div>
						</div>
					</div>
				</div>
			
			</div>
			<div class="col-md-2" id="divstatus">
				<label id="lblStatus" style="margin-bottom:0;padding:5px; font-weight:bold; white-space: nowrap;"></label>
			</div>
		</div>


		<div class="btn-common-panel">
			
			<div style="display:flex; gap:10px;">
				<form id="formBack" method="post" action="/TasklistRemaining/index" style="display:inline;">
				
					<button type="submit" class="btn btn-danger btn-sm fs-13px btn-back hidden">
						<i class="fa fa-arrow-left"></i>&nbsp;  Back
					</button>
				</form>

				<button class="btn btn-primary btn-sm  fs-11px btn-search"><i class="fa fa-search"></i> Browse</button>
				<button class="btn btn-secondary btn-sm  fs-11px btn-clear"><i class="fa fa-refresh"></i> Clear</button>
				<button class="btn btn-primary btn-sm  fs-11px btn-submit"><i class="fa fa-check"></i> Submit</button>
				<input type="hidden" id="txtRemarks" class="form-control" style="width: 250px;" readonly placeholder="Leader Remarks..." />
				@* <button type="button" id="btnViewRemarks" class="btn btn-info w-120px me-15px fs-11px"><i class="fa fa-comments"></i> View Remarks</button> *@
				
			</div>
			<!-- RIGHT: SEARCH -->
			<div class="smart-search">
				<i class="fa fa-search"></i>
				<input type="text" id="tableSearch" placeholder="Search..." />
			</div>
		</div>



		<!-- PANEL BODY -->
		<div class="table-responsive">
			<table id="tableID" class="table table-striped table-bordered w-100 fs-13px">
				<thead>
					<tr role="row">
						@* <th rowspan="2" style="text-align:center;max-width:120px">Action</th> *@
						<th rowspan="2" style="text-align:center;">Group</th>
						<th rowspan="2" style="text-align:center;">Inspection Point</th>
						<th rowspan="2" style="text-align:center;">Unit</th>
						<th colspan="2" style="text-align:center;max-width:150px">Range</th>
						<th rowspan="2" style="text-align:center;">Inspection Result</th>
						<th rowspan="2" style="text-align:center;">Status</th>
						<th rowspan="2" style="text-align:center;">Inspection No</th>
					</tr>
					<tr>
						<th style="text-align:center;width:75px">Min</th>
						<th style="text-align:center;width:75px">Max</th>
					</tr>
				</thead>
			</table>
		</div>


		<div class="col-md-12" style="border-top:1px solid gainsboro;">
			<div style="padding-top:0px;">
				<label> Remarks Send Back : </label>
			</div>
		</div>
		<div class="col-md-12">
			@* <textarea class="form-control" id="RemarksLeader" rows="3" style="resize: none;" autocomplete="false"></textarea> *@
			<textarea id="modalRemarksContent" class="form-control" rows="3" readonly style="resize: none; background-color: #f9f9f9; cursor: not-allowed;"></textarea>
		</div>


		<div class="modal fade" id="MyModal" data-bs-backdrop="static" data-bs-keyboard="false">
			<div class="modal-dialog modal-dialog-centered" style="--bs-modal-width:1000px !important;height:85vh !important;">
				<div class="modal-content">

					<div class="modal-header  theme-color">
						<h5 class="modal-title" id="ModalTitle">Inspection Result Update</h5>
						<button type="button" class="btn-close bg-white-200" data-bs-dismiss="modal"></button>
					</div>

					<div class="modal-body" >

						<input type="hidden" id="InspectionCode-Detail-Hidden" />
						<input type="hidden" id="GroupCode-Detail-Hidden" />
						<input type="hidden" id="InspectionNo-Detail-Hidden" />
						<input type="hidden" id="UnitMethode-Detail-Hidden" />
						<input type="hidden" id="OptionType-Detail-Hidden" />
						<div class="row align-items-center">
							<div class="col-md-7">
								<div style="border: 1px solid lightgray; padding: 15px;  height: 100%;">
									<div class="form-horizontal">

										<div class="form-group">
											<label class="control-label col-sm-3" style="text-align: left; font-weight: normal;">Course</label>
											<div class="col-sm-9">
												<input id="Course-Detail" class="form-control bg-light" type="text" readonly />
											</div>
										</div>

										<div class="form-group">
											<label class="control-label col-sm-3" style="text-align: left; font-weight: normal;">Inspection Date</label>
											<div class="row align-items-center">
												<div class="col-sm-4">
													<input id="InspectionDate-Detail" class="form-control bg-light" type="text" readonly />
												</div>
												<div class="col-sm-3">
													<input id="FrequencyName-Detail" class="form-control bg-light" type="text" readonly />
												</div>
												<div class="col-sm-2">
													<input id="Time-Detail" class="form-control bg-light" type="text" readonly value="16:00" />
												</div>
											</div>
										</div>

										<div class="form-group">
											<label class="control-label col-sm-3" style="text-align: left; font-weight: normal;">Group</label>
											<div class="col-sm-9">
												<input id="Group-Detail" class="form-control bg-light" type="text" readonly />
											</div>
										</div>

										<div class="form-group">
											<label class="control-label col-sm-3" style="text-align: left; font-weight: normal;">Inspection Point</label>
											<div class="col-sm-9">
												<input id="InspectionPoint-Detail" class="form-control bg-light" type="text" readonly />
											</div>
										</div>

										<div class="form-group">
											<label class="control-label col-sm-3" style="text-align: left; font-weight: normal;">Unit</label>
											<div class="col-sm-4">
												<!-- Hapus id="Unit-Detail-Select", cukup gunakan input text readonly -->
												<input id="Unit-Detail" class="form-control bg-light" type="text" readonly />
											</div>
										</div>

										<div class="form-group">
											<label class="control-label col-sm-3" style="text-align: left; font-weight: normal;">Minimum Range</label>
											<div class="col-sm-4">
												<input id="MinRange-Detail" class="form-control bg-light" type="text" readonly />
											</div>
										</div>

										<div class="form-group">
											<label class="control-label col-sm-3" style="text-align: left; font-weight: normal;">Maximum Range</label>
											<div class="col-sm-4">
												<input id="MaxRange-Detail" class="form-control bg-light" type="text" readonly />
											</div>
										</div>

										<div class="form-group" id="divNumericResult">
											<div class="row align-center-items">
												<label class="control-label col-sm-3" style="text-align: left; font-weight: normal;">Inspection Result</label>

												<label id="divlblOptionResult" class="control-label col-sm-3 divOptionResult" style="text-align: left; font-weight: normal;">Options</label>

											</div>
											<div class="row align-center-items">
												<div class="col-sm-3">
													<input id="InspectionResult-Detail" class="form-control" type="text" />
												</div>
												<div class="col-sm-3" id="divOptionResult">
													<select id="cboInspResultOption-Detail" class="form-control"></select>
												</div>
											</div>
										</div>

									</div>
								</div>
							</div>

							<div class="col-md-5">
								<div style="border: 1px solid lightgray ; padding: 15px; height: 100%; min-height: 440px;">
									<div class="form-horizontal">
											<div class="form-group">
												<label class="control-label col-sm-2" style="text-align: left; font-weight: normal;">Path</label>
												<div class="row align-items-center">
													<div class="col-sm-7" style="padding-right: 5px;">
														<input id="imagePath-Detail" type="text" class="form-control bg-light" readonly />
													</div>
													<div class="col-sm-3" style="padding-left: 0;">
														<button type="button" class="btn btn-primary btn-block" onclick="$('#fileUpload-Detail').click();">....</button>
														<input type="file" id="fileUpload-Detail" style="display: none;" accept="image/*" />
													</div>
												</div>
											</div>
										
									</div>

									<div class="text-center" style="margin-top: 15px;">
										<img id="imgPreview-Detail" src="#" alt="Preview" style="max-width: 100%; max-height: 250px; display: none;" />
									</div>
								</div>
							</div>
						</div>
					</div>


					<div class="modal-footer" style="border-top: none; padding-top: 0;">
						<button type="button" class="btn btn-danger" data-bs-dismiss="modal">
							<i class="fa fa-sign-out fa-rotate-180" style="color: white;"></i> BACK
						</button>
						<button type="button" class="btn btn-primary btn-save-detail">
							<i class="fa fa-undo" style="color: white;"></i> REVISE
						</button>
					</div>

				</div>
			</div>
		</div>
	
	</div>
</div>


<style>
	.filter-item {
		display: grid;
		grid-template-columns: 100px 180px 250px;
		align-items: center;
		gap: 10px;
	}

		.filter-item label {
			width: 100px;
			min-width: 100px;
			margin-bottom: 0;
		}

		.filter-item select {
			width: 180px;
		}

	.input-desc {
		width: 100% !important;
	}

	.datepicker-wrapper {
		position: relative;
		width:180px;
	}

		.datepicker-wrapper input {
			width: 100%;
		}

	.datepicker-icon {
		position: absolute;
		right: 10px;
		top: 50%;
		transform: translateY(-50%);
	}
	/* .input-desc {
		width: 250px;
	}
 */
/* 	.input-desc {
		width: 250px !important;
		max-width: 250px;
	} */

	/* =======================================================
	   1920+
	======================================================= */
	@@media (min-width: 1900px) {
		 .filter-item {
			grid-template-columns: 100px 180px 250px;
			gap: 10px;
		}

		.filter-item select, .filter-item .select2-container .datepicker-wrapper {
			width: 180px !important;
		}

		.datepicker-wrapper {
			position: relative;
			width: 180px;
		}
	}

	/* =======================================================
	   1600 - 1899
	======================================================= */
	@@media (min-width: 1600px) and (max-width: 1899px) {
		.filter-item {
			grid-template-columns: 80px 180px 180px;
			gap: 10px;
		}

			.filter-item select, .filter-item .select2-container .datepicker-wrapper {
				width: 180px !important;
		}

		.datepicker-wrapper {
			position: relative;
			width: 180px;
		}
		.input-desc {
			width: 100% !important;
		}

	}

	/* =======================================================
	   1360 - 1599
	======================================================= */
	@@media (min-width: 1360px) and (max-width: 1599px) {
		.filter-item {
			grid-template-columns: 100px 150px 120px;
		}

		.filter-item select,
		.filter-item .select2-container
		.datepicker-wrapper {
				width: 100px !important;
		}

		.datepicker-wrapper {
			position: relative;
			width: 100px;
		}
		.input-desc {
			width: 100% !important;
			
		}

		.smart-search {
			width: 240px;
		}
	}

	/* =======================================================
	   1280 - 1359
	======================================================= */
	@@media (min-width: 1280px) and (max-width: 1359px) {
		.filter-item {
			grid-template-columns: 80px 150px 180px;
		}
		
		.filter-item select,
		.filter-item .select2-container
			.datepicker-wrapper {
			width: 150px !important;
		}

		.datepicker-wrapper {
			position: relative;
			width: 150px;
		}
		.input-desc {
			width: 100% !important;
			
		}

		.smart-search {
			width: 220px;
		}

		.btn-common-panel .btn {
			font-size: 11px;
		}
	}

	/* =======================================================
	   1024 - 1279
	======================================================= */
	@@media (min-width: 1024px) and (max-width: 1279px) {
		.filter-item {
			grid-template-columns: 75px 140px 160px;
		}
		.filter-row {
			gap: 10px;
		}

		.filter-item label {
			width: 75px;
		}

		.filter-item select,
		.filter-item .select2-container
		.datepicker-wrapper {
			width: 140px !important;
		}

		.datepicker-wrapper {
			position: relative;
			width: 140px;
		}
		.input-desc {
			width: 100% !important;
		}

		.smart-search {
			width: 180px;
		}

		.btn-common-panel .btn {
			font-size: 10px;
			padding-left: .5rem;
			padding-right: .5rem;
		}
	}

	/* =======================================================
	   800 - 1023
	======================================================= */
	@@media (max-width: 1023px) {

		.filter-row {
			flex-direction: column;
			gap: 8px;
		}

		.filter-item {
			width: 100%;
		}

			.filter-item label {
				width: 90px;
			}

			.filter-item select,
			.filter-item .select2-container 
			.datepicker-wrapper {
				width: 180px !important;
			}

		.datepicker-wrapper {
			position: relative;
			width: 180px;
		}
		.input-desc {
			width: 100% !important;
		}

		.btn-common-panel {
			flex-direction: column;
			align-items: stretch;
		}

		.smart-search {
			width: 100%;
		}
	}
	
	/* =======================================================
	    800
	======================================================= */
	@@media (min-width: 768px) and (max-width: 1023px) {

		.filter-item {
			grid-template-columns: 90px 100px !important 100%;
		}

			.filter-item label {
				width: 90px;
			}

			.filter-item select,
			.filter-item .select2-container 
			.datepicker-wrapper {
				width: 100px !important;
			}

		.datepicker-wrapper {
			position: relative;
			width: 100px;
		}
		.input-desc {
			width: 100% !important;
		}
	}

	@@media (max-width: 767px){
		.filter-item {
			grid-template-columns: 90px 180px 1fr;
		}

			.filter-item label {
				width: 90px;
			}

			.filter-item select,
			.filter-item .select2-container
			.datepicker-wrapper {
				width: 180px !important;
			}

		.datepicker-wrapper {
			position: relative;
			width: 180px;
		}
		.input-desc {
			width: 100% !important;
		}
	}


	#MyModal .filter-item {
		display: flex;
		align-items: center;
		gap: 10px;
		flex: 0 0 auto;
		padding-bottom: 10px;
	}

	.filter-item label {
		width: 100px;
		margin-bottom: 0;
		font-weight: 500;
	}

	.table > thead {
		vertical-align: bottom;
		line-height: 1.5;
	}

	.table > :not(caption) > * > * {
		padding: .2rem .1rem;
		color: var(--bs-table-color-state, var(--bs-table-color-type, var(--bs-table-color)));
		background-color: var(--bs-table-bg);
		box-shadow: inset 0 0 0 9999px var(--bs-table-bg-state, var(--bs-table-bg-type, var(--bs-table-accent-bg)));
		vertical-align: middle;
		padding-left: 5px !important;
	}

	div.dataTables_scrollBody {
		border: 1px solid lightgray !important;
	}

	.select2-selection__clear {
		display: none !important;
	}

	.select2.select2-container .selection .select2-selection.select2-selection--multiple, .select2.select2-container .selection .select2-selection.select2-selection--single {
		border-color: var(--bs-component-border-color);
		border: 1px solid lightgray !important;
		outline: 0;
		height: calc(1.5em + .875rem + 2px);
		display: flex;
		align-items: center;
		border-radius: 5px !important;
	}


	.text-abnormal td {
		color: #ff4a56 !important;
		font-weight: 800;
		font-weight: bolder;
	}

	.hidden{
		display:none;
	}

	#tableID a {
		color: #0035ff !important;
		text-decoration: none;
	}

	.label-sendback{
		color: black;
		background-color: #ffed4a;
		align-content: center;
		text-align: center;
		font-size: 20px;
		padding: 20px !important;
		margin-bottom: 10px;
	}
	
	.label-upload{
		color:black;
		background-color:lightblue;
		align-content: center;
		text-align: center;
		font-size: 20px;
		padding: 20px !important;
		margin-bottom: 10px;
	}

	.label-check{
		color: black;
		background-color: orange;
		align-content: center;
		text-align: center;
		font-size: 20px;
		padding: 20px !important;
		margin-bottom: 10px;
	}

	.label-approve{
		color:black;
		background-color:lightgreen;
		align-content: center;
		text-align: center;
		font-size: 20px;
		padding: 20px !important;
		margin-bottom: 10px;
	}


</style>
@section Scripts {
	<script>
		var clusterCode = '@ViewData["ClusterCode"]';
		var plantCode = '@ViewData["PlantCode"]';
		var courseCode = '@ViewData["CourseCode"]';
		var groupCode = '@ViewData["GroupCode"]';
		var inspectionDate = '@ViewData["InspectionDate"]';
		var frequency = '@ViewData["Frequency"]';
	</script>
	<script asp-append-version="true">
		window.userPermission = {
			statusAdmin: @(ViewBag.Permission?.StatusAdmin),
			allowUpdate: @(ViewBag.Permission?.AllowUpdate),
			allowDelete: @(ViewBag.Permission?.AllowDelete),
			allowApprove: @(ViewBag.Permission?.AllowApprove)
		};
	</script>

	<script src="~/assets/js/pages/InspectionDataUpload.js" asp-append-version="true"></script>

}