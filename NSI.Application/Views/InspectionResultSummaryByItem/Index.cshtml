@{
	Layout = "_Layout";
}
<div class="panel panel-inverse" style="min-height:86vh;">
	<div class="panel-heading theme-color">
		<h4 class="panel-title fs-5"><i class="bi bi-sign-stop"></i> [@ViewBag.Permission.MenuId] - @ViewBag.Permission.MenuName</h4>
		<div class="panel-heading-btn">
			<a href="javascript:;" class="btn btn-xs btn-icon btn-default panel-border-white" data-toggle="panel-expand"><i class="fa fa-expand"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-success panel-border-white" data-toggle="panel-reload"><i class="fa fa-redo"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-warning panel-border-white" data-toggle="panel-collapse"><i class="fa fa-minus"></i></a>
		</div>
	</div>
	<div class="panel-body">
		<div class="panel-heading col-md-12">
			<div class="row">
				<div class="row mb-2">
					<div class="col-lg-12 col-md-12">
						<div class="filter-item">
							<label>Course</label>
							<select id="CourseCode" name="CourseCode" class="form-select fs-13px">
								<option value="">Fill a Course</option>
							</select>
							<input id="CourseName" class="form-control input-desc fs-13px" type="text" readonly />


						</div>
					</div>
				</div>
				<div class="row mb-2">
					<div class="col-lg-12 col-md-12">
						<div class="filter-item">
							<label>Group</label>
							<select id="GroupCode" name="GroupCode" class="form-select fs-13px">
								<option value="">Fill a Group</option>
							</select>
							<input id="GroupName" class="form-control input-desc fs-13px" type="text" readonly />
							<!-- NAV PREV NEXT BUTTON -->
							@Html.Partial("~/Views/PartialView/_NavButtons.cshtml")
						</div>
						
					</div>
					
				</div>
				<div class="row mb-2">
					<div class="col-lg-12 col-md-12">
						<!--inspection date -->
						<div class="filter-item">
							<label>Inspection Date</label>
							<div class="datepicker-wrapper">
								<input id="InspectionDateFrom" name="InspectionDateFrom" type="text" class="form-control datepicker" autocomplete="off" style="height:35px;"/>
								<span class="datepicker-icon">
									<i class="fa fa-calendar"></i>
								</span>
							</div>
							
							<div class="datepicker-wrapper">
								<input id="InspectionDateTo" name="InspectionDateTo" type="text" class="form-control datepicker" autocomplete="off" style="height:35px;" />
								<span class="datepicker-icon">
									<i class="fa fa-calendar"></i>
								</span>
							</div>
						</div>
					</div>
				</div>
				<div style="display:none;">
					<input id="PlantCode" name="PlantCode" type="text" readonly />

				</div>
			</div>
		</div>
		<div class="btn-common-panel">
			<div style="display:flex; gap:10px;">
				<form id="formBack" method="post" action="/InspectionResultSummaryByGroup/detail" style="display:inline;">
					<input type="hidden" name="ID" value="C04" />
					<input type="hidden" name="ClusterCode" id="ClusterCodeHdn" />
					<input type="hidden" name="PlantCode" id="PlantCodeHdn" />
					<input type="hidden" name="InspectionDateFrom" id="InspectionDateFromHdn" />
					<input type="hidden" name="InspectionDateTo" id="InspectionDateToHdn" />

					<button type="submit" class="btn btn-danger btn-smfs-11px btn-back hidden">
						<i class="fa fa-arrow-left"></i>&nbsp;  Back
					</button>
				</form>
				<button class="btn btn-primary btn-sm fs-11px btn-search"><i class="fa fa-search"></i> Browse</button>
				<button class="btn btn-secondary btn-sm fs-11px btn-clear"><i class="fa fa-refresh"></i> Clear</button>
				<button class="btn btn-success btn-sm fs-11px btn-excel"><i class="fa fa-export"></i> Excel</button>
			</div>


		</div>

		<div style="height:15px;"></div>
		<div class="row col-md-12" style="border:1px solid lightgray !important;padding-left:10px;padding-top:15px;padding-right:10px;padding-bottom:10px !important">
			<div class="col-md-5">
				<div >
					<div class="col-md-12">
						<div style="display:flex; gap:10px;">
							<div class="smart-search">
								<i class="fa fa-search"></i>
								<input type="text" id="tableSearch" class="dt-search" data-table="#tableID" placeholder="Search..." />
							</div>
						</div>

						<table id="tableID" class="table table-striped table-bordered w-100 fs-13px" border="1">
							<thead>
								<tr role="row">
									<th style="vertical-align:central;text-align:center !important;">No</th>
									<th style="vertical-align:central;text-align:center !important;">Inspection Point</th>
									<th style="vertical-align:central;text-align:center !important;">Abnormal</th>
								</tr>
							</thead>
							<tbody>
							</tbody>
						</table>
					</div>
				</div>
			</div>
			<div class="col-md-7">
				<div class="chart-wrapper">
					<div class="card chart-card">
						<div id="chartTitle" class="chart-title"></div>
						<div class="chart-container">
							<canvas id="paretoChart" style="width:400px;height:280px"></canvas>
						</div>
						<div class="chart-title" id="chartFooter">Inspection Point</div>

					</div>
				</div>
			</div>
		</div>

		
	</div>
</div>


<link href="~/assets/css/pages/inpectionresult.css" rel="stylesheet" asp-append-version="true" />
<style>
	.filter-item {
		display: grid;
		grid-template-columns: 100px 180px 250px 200px;
		align-items: center;
		gap: 10px;
	}

		.filter-item label {
			width: 100px;
			min-width: 100px;
			margin-bottom: 0;
		}


	.input-desc {
		width: 100% !important;
	}

	.datepicker-wrapper {
		position: relative;
		width: 180px !important;
	}

		.datepicker-wrapper input {
			width: 100%;
		}

	.datepicker-icon {
		position: absolute;
		right: 10px;
		top: 50%;
		transform: translateY(-50%);
	}



	/* =======================================================
					   1024 - 1279
	======================================================= */
	@@media (min-width: 1024px) and (max-width: 1279px) {
		.filter-item {
			grid-template-columns: 100px 180px 220px 240px;
		}

		.filter-row {
			gap: 10px;
		}

		.filter-item label {
			width: 100px;
		}

		.filter-item select,
		.filter-item .select2-container
		.datepicker-wrapper {
			width: 180px !important;
		}

		.datepicker-wrapper {
			position: relative;
			width: 180px !important;
		}
		.input-desc {
			width: 100% !important;
		}

		.smart-search {
			width: 180px;
		}

		.btn-common-panel .btn {
			font-size: 10px;
			padding-left: .5rem;
			padding-right: .5rem;
		}
	}

	/* =======================================================
					   800 - 1023
	======================================================= */
	@@media (max-width: 1023px) {
		.filter-row {
			flex-direction: column;
			gap: 8px;
		}

		.filter-item {
			width: 100%;
		}

			.filter-item label {
				width: 100px;
			}

			.filter-item select,
			.filter-item .select2-container
			.datepicker-wrapper {
				width: 180px !important;
			}

		.datepicker-wrapper {
			position: relative;
			width: 180px !important;
		}
		.input-desc {
			width: 100% !important;
		}

		.btn-common-panel {
			flex-direction: column;
			align-items: stretch;
		}

		.smart-search {
			width: 100%;
		}
	}

	/* =======================================================
						800
	======================================================= */
	@@media (min-width: 768px) and (max-width: 1023px) {
		.filter-item {
			grid-template-columns: 90px 150px !important 100%;
		}

			.filter-item label {
				width: 90px;
			}

			.filter-item select,
			.filter-item .select2-container
			.datepicker-wrapper {
				width: 150px !important;
			}

		.datepicker-wrapper {
			position: relative;
			width: 180px !important;
		}
		.input-desc {
			width: 100% !important;
		}
	}

	@@media (max-width: 767px) {
		.filter-item {
			grid-template-columns: 90px 130px 1fr;
		}

			.filter-item label {
				width: 90px;
			}

			.filter-item select,
			.filter-item .select2-container
			.datepicker-wrapper {
				width: 130px !important;
			}

		.datepicker-wrapper {
			position: relative;
			width: 180px !important;
		}
		.input-desc {
			width: 100% !important;
		}
	}
</style>

@section Scripts {
	<script>
		var clusterCode = '@ViewData["ClusterCode"]';
		var plantCode = '@ViewData["PlantCode"]';
		var courseCode = '@ViewData["CourseCode"]';
		var groupCode = '@ViewData["GroupCode"]';
		var inspectionDateFrom = '@ViewData["inspectionDateFrom"]';
		var inspectionDateTo = '@ViewData["inspectionDateTo"]';
	</script>
	<script asp-append-version="true">
		window.userPermission = {
			statusAdmin: @(ViewBag.Permission?.StatusAdmin),
			allowUpdate: @(ViewBag.Permission?.AllowUpdate),
			allowDelete: @(ViewBag.Permission?.AllowDelete),
			allowApprove: @(ViewBag.Permission?.AllowApprove)
		};
	</script>

	<script src="~/assets/js/pages/InspectionResultByItem.js" asp-append-version="true"></script>
}