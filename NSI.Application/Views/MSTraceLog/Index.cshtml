	.filter-label {
		width: 70px;
		flex: 0 0 auto;
	}


	.input-desc {
		flex: 1 1 250px auto;
		max-width: 250px !important
	}

	.table > thead {
		vertical-align: bottom;
		line-height: 2;
	}

	.table > :not(caption) > * > * {
		padding: .2rem .1rem;
		color: var(--bs-table-color-state, var(--bs-table-color-type, var(--bs-table-color)));
		background-color: var(--bs-table-bg);
		box-shadow: inset 0 0 0 9999px var(--bs-table-bg-state, var(--bs-table-bg-type, var(--bs-table-accent-bg)));
		vertical-align: middle;
		padding-left: 5px !important;
	}

	div.dataTables_scrollBody {
		border: 1px solid lightgray !important;
	}

	.select2-selection__clear {
		display: none !important;
	}

	.select2.select2-container .selection .select2-selection.select2-selection--multiple, .select2.select2-container .selection .select2-selection.select2-selection--single {
		border-color: var(--bs-component-border-color);
		border: 1px solid lightgray !important;
		outline: 0;
		height: calc(1.5em + .875rem + 2px);
		display: flex;
		align-items: center;
		border-radius: 5px !important;
	}


	.sWidth-ddl {
		width: 150px !important;
	}
</style>

<div class="panel panel-inverse" style="min-height:86vh;">
	<div class="panel-heading theme-color">
		<h4 class="panel-title fs-5"><i class="bi bi-sign-stop"></i> [@ViewBag.Permission.MenuId] - @ViewBag.Permission.MenuName</h4>
		<div class="panel-heading-btn">
			<a href="javascript:;" class="btn btn-xs btn-icon btn-default panel-border-white" data-toggle="panel-expand"><i class="fa fa-expand"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-success panel-border-white" data-toggle="panel-reload"><i class="fa fa-redo"></i></a>
			<a href="javascript:;" class="btn btn-xs btn-icon btn-warning panel-border-white" data-toggle="panel-collapse"><i class="fa fa-minus"></i></a>
		</div>
	</div>

	<div class="panel-body">
		<div class="panel-heading col-12">
			@* <div style="display:flex; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom: 10px;">
				<label class="mb-0" style="width: 80px;">Module</label>
				<select id="ModuleFilter" class="selectpicker form-control" data-live-search="true" data-width="150px">
				</select>
				<input id="ModuleNameFilter" class="form-control" style="width:250px" type="text" readonly placeholder="Module Name" />
			</div> *@

			<div class="d-flex flex-column gap-2 w-100">
				<!-- module -->
				<div class="filter-group">

					<div class="d-flex align-items-center flex-wrap gap-2">

						<label class="mb-0 text-dark text-nowrap filter-label">
							Module
						</label>

						<div class="filter-ddl pe-2">
							<select id="ModuleFilter" name="ModuleFilter" class="form-select fs-13px">
							</select>
						</div>
						<input id="ModuleNameFilter" name="ModuleNameFilter" class="form-control input-desc fs-13px" type="text" readonly placeholder="Module Name" />

					</div>

				</div>

				<div class="filter-group">

					<div class="d-flex align-items-center flex-wrap gap-2">

						<label class="mb-0 text-dark text-nowrap filter-label">
							Log Date
						</label>
						<div class="datepicker-wrapper">
							<input id="StartDateFilter" name="StartDateFilter" type="text" maxlength="13" class="form-control datepicker" autocomplete="off" />
							<span class="datepicker-icon">
								<i class="fa fa-calendar"></i>
							</span>
						</div>
						<span>~</span>
						<div class="datepicker-wrapper">
							<input id="EndDateFilter" name="EndDateFilter" type="text" maxlength="13" class="form-control datepicker" autocomplete="off" />
							<span class="datepicker-icon">
								<i class="fa fa-calendar"></i>
							</span>
						</div>
					</div>

				</div>
			</div>

			
			
			@* <div class="filter-row">
				<!--log date -->
				<div class="filter-item">
					<label>Log Date From</label>
					<div class="datepicker-wrapper">
						<input id="StartDateFilter" name="StartDateFilter" type="text" maxlength="13" class="form-control datepicker" autocomplete="off" />
						<span class="datepicker-icon">
							<i class="fa fa-calendar"></i>
						</span>
					</div>
					<span>~</span>
					<div class="datepicker-wrapper">
						<input id="EndDateFilter" name="EndDateFilter" type="text" maxlength="13" class="form-control datepicker" autocomplete="off" />
						<span class="datepicker-icon">
							<i class="fa fa-calendar"></i>
						</span>
					</div>
				</div>
			</div>
 *@
		</div>

		<div class="btn-common-panel">
			<div style="display:flex; gap:10px;">
				<button id="btnSearch" class="btn btn-primary btn-sm fs-11px btn-search" type="button"><i class="fa fa-search"></i> Browse</button>
				<button id="btnExcel" class="btn btn-success btn-sm  fs-11px" type="button" onclick="DownloadExcel()"><i class="fa fa-file-excel-o"></i> Excel</button>
			</div>

			<div class="smart-search">
				<i class="fa fa-search"></i>
				<input type="text" id="tableSearch" placeholder="Search..." />
			</div>
		</div>


		<div class="table-responsive">
			<table id="tableID" class="table table-striped table-bordered w-100 fs-13px" style="min-width:2000px">
				<thead>
					<tr role="row">
						<th style="text-align:center;width:2000px;">Log Date</th>
						<th style="text-align:center;width:2000px;">User ID</th>
						<th style="text-align:center;width:200px;">IP Address</th>
						<th style="text-align:center;">Module</th>
						<th style="text-align:center;width:120px;">Action</th>
						<th style="text-align:center;">Event Log</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
	</div>

</div>

@section Scripts {
	<script asp-append-version="true">
		window.userPermission = {
			statusAdmin: @(ViewBag.Permission?.StatusAdmin),
			allowUpdate: @(ViewBag.Permission?.AllowUpdate),
			allowDelete: @(ViewBag.Permission?.AllowDelete),
			allowApprove: @(ViewBag.Permission?.AllowApprove)
		};
	</script>

	<script src="~/assets/js/pages/mstracelog.js" asp-append-version="true"></script>
}